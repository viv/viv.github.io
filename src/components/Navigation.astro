---
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const isHome = currentPath === '/' || currentPath === '';

const navLinks = [
  { label: 'About', href: `${isHome ? '' : '/'}#about` },
  { label: 'Expertise', href: `${isHome ? '' : '/'}#expertise` },
  { label: 'Experience', href: `${isHome ? '' : '/'}#experience` },
  { label: 'Open Source', href: `${isHome ? '' : '/'}#open-source` },
  { label: 'Beyond the Code', href: `${isHome ? '' : '/'}#beyond` },
  { label: 'Field Notes', href: `${isHome ? '' : '/'}#notes` },
  { label: 'Contact', href: `${isHome ? '' : '/'}#contact` },
];
---

<nav
  id="main-nav"
  aria-label="Main"
  class="fixed top-0 left-0 right-0 z-50 border-b border-transparent transition-all duration-300"
>
  <div class="relative z-50 max-w-6xl mx-auto px-6 flex items-center justify-end h-16">
    {/* Desktop nav */}
    <ul class="hidden lg:flex items-center gap-4 xl:gap-8 list-none">
      {navLinks.map((link) => {
        const sectionId = link.href.includes('#') ? link.href.split('#')[1] : null;
        return (
          <li>
            <a
              href={link.href}
              class="nav-link text-sm text-text-secondary hover:text-text-primary transition-colors link-hover whitespace-nowrap focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg/80 rounded-sm"
              {...(sectionId ? { 'data-section': sectionId } : {})}
            >
              {link.label}
            </a>
          </li>
        );
      })}
      <li>
        <ThemeToggle />
      </li>
    </ul>

    {/* Mobile: theme toggle + hamburger */}
    <div class="lg:hidden flex items-center gap-2">
      <ThemeToggle />
      <button
        id="nav-toggle"
        class="flex flex-col gap-1.5 p-2 bg-transparent border-none rounded-lg focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="nav-overlay"
      >
        <span class="burger-line burger-top block w-6 h-0.5 bg-text-primary transition-transform duration-300 origin-center" />
        <span class="burger-line burger-mid block w-6 h-0.5 bg-text-primary transition-opacity duration-300" />
        <span class="burger-line burger-bot block w-6 h-0.5 bg-text-primary transition-transform duration-300 origin-center" />
      </button>
    </div>
  </div>

</nav>

{/* Mobile overlay — outside <nav> to avoid backdrop-filter containing block issue */}
<div
  id="nav-overlay"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  class="fixed inset-0 z-40 bg-bg/95 backdrop-blur-md flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
>
  <ul class="flex flex-col items-center gap-8">
    {navLinks.map((link, i) => (
      <li class="nav-stagger" style={`--stagger: ${i}`}>
        <a
          href={link.href}
          class="nav-overlay-link text-2xl text-text-secondary hover:text-accent transition-colors"
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</div>

{/* Live region for screen reader announcements */}
<div id="nav-announcer" aria-live="polite" aria-atomic="true" class="sr-only"></div>

<script>
  const nav = document.getElementById('main-nav')!;
  const toggle = document.getElementById('nav-toggle')!;
  const overlay = document.getElementById('nav-overlay')!;
  const announcer = document.getElementById('nav-announcer')!;
  let open = false;

  function announce(message: string) {
    announcer.textContent = '';
    // Brief delay ensures screen readers register the change
    requestAnimationFrame(() => { announcer.textContent = message; });
  }

  function setOverlay(show: boolean) {
    open = show;
    toggle.setAttribute('aria-expanded', String(show));
    toggle.setAttribute('aria-label', show ? 'Close navigation' : 'Open navigation');
    if (show) {
      overlay.classList.remove('opacity-0', 'pointer-events-none');
      overlay.classList.add('opacity-100', 'pointer-events-auto');
      toggle.classList.add('burger-open');
      announce('Navigation menu opened');
      // Focus the first link in the overlay for keyboard users
      const firstLink = overlay.querySelector('a');
      if (firstLink) firstLink.focus();
    } else {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      overlay.classList.remove('opacity-100', 'pointer-events-auto');
      toggle.classList.remove('burger-open');
      announce('Navigation menu closed');
      // Return focus to the toggle button
      toggle.focus();
    }
  }

  toggle.addEventListener('click', () => setOverlay(!open));

  // Keyboard handling: Escape to close, Tab focus trap
  document.addEventListener('keydown', (e) => {
    if (!open) return;

    if (e.key === 'Escape') {
      setOverlay(false);
      return;
    }

    // Focus trap within the overlay
    if (e.key === 'Tab') {
      const focusable = overlay.querySelectorAll<HTMLElement>('a, button');
      if (focusable.length === 0) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];

      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first.focus();
      }
    }
  });

  overlay.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOverlay(false));
  });

  // Scroll behaviour: add backdrop on scroll
  function updateNavBackground() {
    if (window.scrollY > 50) {
      nav.classList.add('bg-bg/80', 'backdrop-blur-md', 'border-border-subtle');
      nav.classList.remove('border-transparent');
    } else {
      nav.classList.remove('bg-bg/80', 'backdrop-blur-md', 'border-border-subtle');
      nav.classList.add('border-transparent');
    }
  }
  window.addEventListener('scroll', updateNavBackground);
  updateNavBackground();

  // Scroll-spy: highlight the current section in the nav
  const navLinksWithSection = nav.querySelectorAll<HTMLAnchorElement>('a[data-section]');
  const sectionIds = Array.from(navLinksWithSection).map((a) => a.dataset.section!);
  const sections = sectionIds
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  if (sections.length > 0) {
    const visibleSections = new Set<string>();
    let lastAnnouncedSection = '';
    let scrollSpyTimeout: ReturnType<typeof setTimeout>;

    function isAtBottom() {
      return window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 50;
    }

    function updateActiveLink() {
      navLinksWithSection.forEach((a) => a.classList.remove('nav-active'));

      // If scrolled to the very bottom, activate the last section (Contact)
      if (isAtBottom()) {
        const lastLink = nav.querySelector('a[data-section="contact"]');
        if (lastLink) lastLink.classList.add('nav-active');
        return;
      }

      if (visibleSections.size === 0) return;

      // Of the visible sections, pick the one closest to the top of the viewport
      let activeId = '';
      let minTop = Infinity;
      for (const id of visibleSections) {
        const el = document.getElementById(id);
        if (el) {
          const top = Math.abs(el.getBoundingClientRect().top);
          if (top < minTop) {
            minTop = top;
            activeId = id;
          }
        }
      }

      if (activeId) {
        const activeLink = nav.querySelector(`a[data-section="${activeId}"]`);
        if (activeLink) activeLink.classList.add('nav-active');

        // Announce section change (debounced to avoid rapid-fire announcements)
        if (activeId !== lastAnnouncedSection) {
          lastAnnouncedSection = activeId;
          clearTimeout(scrollSpyTimeout);
          scrollSpyTimeout = setTimeout(() => {
            const label = activeLink?.textContent?.trim();
            if (label) announce(`Now viewing: ${label}`);
          }, 1000);
        }
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            visibleSections.add(entry.target.id);
          } else {
            visibleSections.delete(entry.target.id);
          }
        }
        updateActiveLink();
      },
      { rootMargin: '-20% 0px -60% 0px' }
    );

    sections.forEach((section) => observer.observe(section));

    // Also check on scroll for the bottom-of-page case
    window.addEventListener('scroll', updateActiveLink, { passive: true });
  }
</script>

<style>
  /* Staggered entrance for mobile nav links */
  .nav-stagger {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.3s ease, transform 0.3s ease;
    transition-delay: calc(var(--stagger) * 0.05s);
  }

  #nav-overlay.opacity-100 .nav-stagger {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-stagger {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }

  /* Hamburger → X animation */
  .burger-open .burger-top {
    transform: rotate(45deg) translateY(4px);
  }

  .burger-open .burger-mid {
    opacity: 0;
  }

  .burger-open .burger-bot {
    transform: rotate(-45deg) translateY(-4px);
  }

  /* Scroll-spy active section indicator */
  .nav-active {
    color: var(--color-accent);
  }
</style>

---
import { Image } from 'astro:assets';
import architectureImg from '../assets/expertise/architecture.png';
import secureImg from '../assets/expertise/secure_by_design.png';
import aiImg from '../assets/expertise/ai_engineering.png';
import mentoringImg from '../assets/expertise/mentoring.png';

const items = [
  {
    title: 'Building systems that last',
    image: architectureImg,
    text: "25+ years building software across government, finance, cyber security, and identity verification. Pragmatic architecture, clear boundaries, ruthless simplicity where it matters, and the discipline to maintain backward compatibility when the easy option would be to break everything.",
  },
  {
    title: 'Secure by design',
    image: secureImg,
    text: "Years working with government, CISOs, and governance boards. Security isn't something you bolt on. It's how you think about trust boundaries, identity, data flow, and the human decisions around all of it.",
  },
  {
    title: 'AI-augmented engineering',
    image: aiImg,
    text: "Not theoretical. Practical. AI is a core part of the daily engineering workflow, managed with the same XP and engineering discipline you'd apply to any team. Also led formal government-commissioned research evaluating AI security tools. You know where AI helps, where it hallucinates, and why experienced engineers get more from it than novices.",
  },
  {
    title: 'Growing engineers',
    image: mentoringImg,
    text: "Mentoring apprentices. Hosting work experience. Running 1:1s, 360-degree feedback, and CPD programmes. The best investment a senior engineer can make is in the people around them.",
  },
];
---

<section id="expertise" class="py-24 sm:py-32">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-4xl sm:text-5xl font-bold text-text-primary mb-16">What I Do</h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {items.map((item) => (
        <div
          data-animate="fade-up"
          class="bg-bg-surface border border-border-subtle rounded-lg p-6 sm:p-8"
        >
          <Image
            src={item.image}
            alt=""
            width={64}
            height={64}
            class="rounded-lg mb-4 opacity-80"
          />
          <h3 class="text-lg font-semibold text-text-primary mb-3">{item.title}</h3>
          <p class="text-text-secondary leading-relaxed">{item.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

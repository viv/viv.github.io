---
import { getCollection, render } from 'astro:content';

const allEntries = await getCollection('timeline');
const sortedEntries = allEntries.sort((a, b) => a.data.order - b.data.order);
const tier1 = sortedEntries.filter((e) => e.data.tier === 1);
const tier2 = sortedEntries.filter((e) => e.data.tier === 2);

// Pre-render all entries
const tier1Rendered = await Promise.all(
  tier1.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
const tier2Rendered = await Promise.all(
  tier2.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

// Import timeline images
const timelineImages: Record<string, string> = {};
const imageModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/timeline/*.png', {
  eager: true,
});
for (const [path, mod] of Object.entries(imageModules)) {
  const name = path.split('/').pop()?.replace('.png', '') ?? '';
  timelineImages[name] = mod.default.src;
}
---

<section id="experience" class="py-24 sm:py-32">
  <div class="max-w-4xl mx-auto px-6">
    <h2 class="text-4xl sm:text-5xl font-bold text-accent mb-16">Experience</h2>

    {/* Tier 1 entries with timeline line */}
    <div class="relative">
      {/* Vertical timeline line */}
      <div class="absolute left-4 sm:left-6 top-0 bottom-0 w-px bg-border-subtle" />

      <div class="space-y-12">
        {tier1Rendered.map(({ entry, Content }) => {
          const imageSrc = entry.data.image ? timelineImages[entry.data.image] : null;
          return (
            <article
              data-animate="timeline-entry"
              class="relative pl-12 sm:pl-16"
            >
              {/* Timeline dot */}
              <div class="absolute left-2.5 sm:left-4.5 top-6 w-3 h-3 rounded-full bg-accent border-2 border-bg" />

              <div class="bg-bg-surface border border-border-subtle rounded-lg p-6 sm:p-8">
                <div class="flex flex-col sm:flex-row sm:items-start gap-4 sm:gap-6">
                  <div class="flex-1">
                    <span class="text-sm text-text-secondary">{entry.data.year}</span>
                    <h3 class="mt-1 text-xl text-accent-light italic">
                      &ldquo;{entry.data.headline}&rdquo;
                    </h3>
                    <div class="mt-4 text-text-primary leading-relaxed prose-p:mb-4 [&>p:last-child]:mb-0">
                      <Content />
                    </div>
                    {entry.data.techFootnote && entry.data.techFootnote !== 'None' && (
                      <p class="mt-4 text-sm font-mono text-text-tertiary italic">
                        {entry.data.techFootnote}
                      </p>
                    )}
                  </div>

                  {imageSrc && (
                    <div class="shrink-0">
                      <img
                        src={imageSrc}
                        alt=""
                        class="w-20 h-20 sm:w-24 sm:h-24 rounded-lg object-cover opacity-80"
                      />
                    </div>
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>

    {/* See Full Timeline button */}
    <div class="mt-12 text-center">
      <button
        id="timeline-expand"
        class="inline-flex items-center gap-2 px-6 py-3 border border-accent text-accent rounded-lg hover:bg-accent/10 transition-colors text-sm font-medium"
      >
        See Full Timeline
        <svg class="w-4 h-4 transition-transform duration-300" id="timeline-chevron" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </button>
    </div>

    {/* Tier 2 entries */}
    <div id="timeline-tier2" class="hidden mt-12 space-y-8">
      {tier2Rendered.map(({ entry, Content }) => (
        <article data-animate="timeline-entry" class="p-6 sm:p-8 rounded-lg">
          <span class="text-sm text-text-secondary">{entry.data.year}</span>
          <h3 class="mt-1 text-lg text-accent-light italic">
            &ldquo;{entry.data.headline}&rdquo;
          </h3>
          <div class="mt-3 text-text-primary leading-relaxed prose-p:mb-3 [&>p:last-child]:mb-0">
            <Content />
          </div>
          {entry.data.techFootnote && entry.data.techFootnote !== 'None' && (
            <p class="mt-3 text-sm font-mono text-text-tertiary italic">
              {entry.data.techFootnote}
            </p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('timeline-expand')!;
  const tier2 = document.getElementById('timeline-tier2')!;
  const chevron = document.getElementById('timeline-chevron')!;
  let expanded = false;

  btn.addEventListener('click', () => {
    expanded = !expanded;
    tier2.classList.toggle('hidden');
    chevron.style.transform = expanded ? 'rotate(180deg)' : '';
    btn.querySelector('span')?.remove();

    // Re-trigger GSAP animations on newly visible entries if GSAP is available
    if (expanded && typeof window !== 'undefined' && (window as any).__gsapScrollTrigger) {
      (window as any).__gsapScrollTrigger.refresh();
    }
  });
</script>

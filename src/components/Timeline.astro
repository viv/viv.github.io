---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';

const allEntries = await getCollection('timeline');
const sortedEntries = allEntries.sort((a, b) => a.data.order - b.data.order);

// Split point: first N entries shown by default, rest hidden behind "See Full Timeline"
const splitAt = Math.ceil(sortedEntries.length / 2);
const primaryEntries = sortedEntries.slice(0, splitAt);
const expandedEntries = sortedEntries.slice(splitAt);

// Pre-render all entries
const primaryRendered = await Promise.all(
  primaryEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);
const expandedRendered = await Promise.all(
  expandedEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  })
);

// Import timeline images — keep as ImageMetadata for Astro <Image> optimisation
const timelineImages: Record<string, ImageMetadata> = {};
const imageModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/timeline/*.png', {
  eager: true,
});
for (const [path, mod] of Object.entries(imageModules)) {
  const name = path.split('/').pop()?.replace('.png', '') ?? '';
  timelineImages[name] = mod.default;
}
---

<section id="experience" aria-label="Experience" class="pt-14 pb-10 sm:pt-20 sm:pb-16">
  <div class="max-w-4xl mx-auto px-6">
    <h2 data-animate="fade-up" class="text-4xl sm:text-5xl font-bold text-text-primary mb-16">Experience</h2>

    <div class="relative">
      {/* Vertical timeline line */}
      <div class="absolute left-3 sm:left-6 top-0 bottom-0 w-[2px] bg-accent/20" />

      <div class="space-y-12">
        {primaryRendered.map(({ entry, Content }) => {
          const imageSrc = entry.data.image ? timelineImages[entry.data.image] : undefined;
          return (
            <article
              data-animate="timeline-entry"
              class="relative pl-10 sm:pl-16"
            >
              {/* Timeline dot */}
              <div class="absolute left-[6px] sm:left-[18px] top-6 w-3 h-3 rounded-full bg-accent border-2 border-bg" />

              <div class="bg-bg-surface border border-border-subtle rounded-lg p-6 sm:p-8 card-hover">
                <div class="flex items-start gap-6">
                  <div class="flex-1">
                    <span class="text-sm text-text-secondary">{entry.data.year}</span>
                    <h3 class="mt-1 text-lg font-semibold text-text-primary">{entry.data.title}</h3>
                    <p class="mt-1 text-xl text-accent-light italic">
                      &ldquo;{entry.data.headline}&rdquo;
                    </p>
                  </div>
                  {imageSrc && (
                    <div class="hidden sm:block shrink-0">
                      {timelineImages[entry.data.image + '-light'] ? (
                        <>
                          <Image
                            src={imageSrc}
                            alt=""
                            width={160}
                            loading="lazy"
                            class="w-32 sm:w-40 h-auto rounded-lg object-contain opacity-80 dark-only"
                          />
                          <Image
                            src={timelineImages[entry.data.image + '-light']}
                            alt=""
                            width={160}
                            loading="lazy"
                            class="w-32 sm:w-40 h-auto rounded-lg object-contain opacity-80 light-only"
                          />
                        </>
                      ) : (
                        <Image
                          src={imageSrc}
                          alt=""
                          width={160}
                          loading="lazy"
                          class="w-32 sm:w-40 h-auto rounded-lg object-contain opacity-80"
                        />
                      )}
                    </div>
                  )}
                </div>
                <div class="mt-4 text-text-primary leading-relaxed [&>p]:mb-4 [&>p:last-child]:mb-0 [&_a]:text-accent-functional [&_a:hover]:text-accent-light [&_a]:transition-colors">
                  <Content />
                </div>
                {entry.data.techFootnote && entry.data.techFootnote !== 'None' && (
                  <p class="mt-4 text-sm font-mono text-text-tertiary italic break-words">
                    {entry.data.techFootnote}
                  </p>
                )}
              </div>
            </article>
          );
        })}
      </div>

      {/* See Full Timeline button */}
      <div class="mt-12 text-center">
        <button
          id="timeline-expand"
          aria-expanded="false"
          aria-controls="timeline-expanded"
          class="inline-flex items-center gap-2 px-6 py-3 bg-transparent border border-accent text-accent rounded-lg hover:bg-accent/10 active:bg-accent/20 transition-colors text-sm font-medium focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
        >
          <span id="timeline-expand-text">See Full Timeline</span>
          <svg class="w-4 h-4 transition-transform duration-300" id="timeline-chevron" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
      </div>

      {/* Expanded entries */}
      <div id="timeline-expanded" class="hidden mt-12 space-y-12">
        {expandedRendered.map(({ entry, Content }) => {
          const imageSrc = entry.data.image ? timelineImages[entry.data.image] : undefined;
          return (
            <article class="timeline-expanded-entry relative pl-10 sm:pl-16">
              {/* Timeline dot */}
              <div class="absolute left-[6px] sm:left-[18px] top-6 w-3 h-3 rounded-full bg-accent border-2 border-bg" />

              <div class="bg-bg-surface border border-border-subtle rounded-lg p-6 sm:p-8 card-hover">
                <div class="flex items-start gap-6">
                  <div class="flex-1">
                    <span class="text-sm text-text-secondary">{entry.data.year}</span>
                    <h3 class="mt-1 text-lg font-semibold text-text-primary">{entry.data.title}</h3>
                    <p class="mt-1 text-xl text-accent-light italic">
                      &ldquo;{entry.data.headline}&rdquo;
                    </p>
                  </div>
                  {imageSrc && (
                    <div class="hidden sm:block shrink-0">
                      {timelineImages[entry.data.image + '-light'] ? (
                        <>
                          <Image
                            src={imageSrc}
                            alt=""
                            width={160}
                            loading="lazy"
                            class="w-32 sm:w-40 h-auto rounded-lg object-contain opacity-80 dark-only"
                          />
                          <Image
                            src={timelineImages[entry.data.image + '-light']}
                            alt=""
                            width={160}
                            loading="lazy"
                            class="w-32 sm:w-40 h-auto rounded-lg object-contain opacity-80 light-only"
                          />
                        </>
                      ) : (
                        <Image
                          src={imageSrc}
                          alt=""
                          width={160}
                          loading="lazy"
                          class="w-32 sm:w-40 h-auto rounded-lg object-contain opacity-80"
                        />
                      )}
                    </div>
                  )}
                </div>
                <div class="mt-4 text-text-primary leading-relaxed [&>p]:mb-4 [&>p:last-child]:mb-0 [&_a]:text-accent-functional [&_a:hover]:text-accent-light [&_a]:transition-colors">
                  <Content />
                </div>
                {entry.data.techFootnote && entry.data.techFootnote !== 'None' && (
                  <p class="mt-4 text-sm font-mono text-text-tertiary italic break-words">
                    {entry.data.techFootnote}
                  </p>
                )}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('timeline-expand')!;
  const expanded_section = document.getElementById('timeline-expanded')!;
  const chevron = document.getElementById('timeline-chevron')!;
  const btnText = document.getElementById('timeline-expand-text')!;
  let expanded = false;

  btn.addEventListener('click', () => {
    expanded = !expanded;
    expanded_section.classList.toggle('hidden');
    chevron.style.transform = expanded ? 'rotate(180deg)' : '';
    btn.setAttribute('aria-expanded', String(expanded));
    btnText.textContent = expanded ? 'Hide Full Timeline' : 'See Full Timeline';

    // Move focus to the first newly revealed entry for keyboard users
    if (expanded) {
      const firstEntry = expanded_section.querySelector('article');
      if (firstEntry) {
        firstEntry.setAttribute('tabindex', '-1');
        firstEntry.focus({ preventScroll: false });
      }
    }

    // Create GSAP animations for newly visible entries
    if (expanded && typeof window !== 'undefined') {
      const gsapLib = (window as any).__gsap;
      const ST = (window as any).__gsapScrollTrigger;
      const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (gsapLib && ST && !prefersReduced) {
        ST.refresh();
        expanded_section.querySelectorAll('.timeline-expanded-entry').forEach((el: Element) => {
          gsapLib.from(el, {
            scrollTrigger: {
              trigger: el,
              start: 'top 90%',
              toggleActions: 'play none none none',
            },
            y: 50,
            opacity: 0,
            duration: 1,
            ease: 'power3.out',
          });
        });
      }
    }
  });
</script>

---
import { Image } from 'astro:assets';
import karateImg from '../assets/beyond-code/karate.png';
import mtbImg from '../assets/beyond-code/mtb_outdoors.png';
import smartHomeImg from '../assets/beyond-code/smart_home.png';
import karateImgLight from '../assets/beyond-code/karate-light.png';
import mtbImgLight from '../assets/beyond-code/mtb_outdoors-light.png';
import smartHomeImgLight from '../assets/beyond-code/smart_home-light.png';


const cards = [
  {
    title: 'Wado Ryu Karate',
    image: karateImg,
    imageLight: karateImgLight,
    text: "3rd Dan black belt and instructor in <a href='https://en.wikipedia.org/wiki/Wad%C5%8D-ry%C5%AB' target='_blank' rel='noopener noreferrer' class='text-accent-functional hover:text-accent-light transition-colors'>Wado Ryu</a>. I originally started accompanying my kids and stuck with it. I'm drawn to the discipline it demands, the satisfaction of teaching, and the rich history of practical application",
    link: { label: 'ogwrkarate.co.uk', href: 'https://www.ogwrkarate.co.uk' },
  },
  {
    title: 'Mountain Biking',
    image: mtbImg,
    imageLight: mtbImgLight,
    text: "I've been mountain biking for over 30 years, I'm lucky to be surrounded by great countryside,  community, and trails in South Wales. I also enjoy running, rowing, and exploring the nearby mountains and forests on foot.",
    link: null,
  },
  {
    title: 'Smart Home & IoT',
    image: smartHomeImg,
    imageLight: smartHomeImgLight,
    text: "<a href='https://www.home-assistant.io/' target='_blank' rel='noopener noreferrer' class='text-accent-functional hover:text-accent-light transition-colors'>Home Assistant</a>, <a href='https://csa-iot.org/all-solutions/matter/' target='_blank' rel='noopener noreferrer' class='text-accent-functional hover:text-accent-light transition-colors'>Matter</a>, <a href='https://www.threadgroup.org/' target='_blank' rel='noopener noreferrer' class='text-accent-functional hover:text-accent-light transition-colors'>Thread</a>, Apple Home. Engineering curiosity applied to domestic life. Building automations, tinkering with protocols, and trying to make the house smarter without making it fragile.",
    link: null,
  },
];
---

<section id="beyond" aria-label="Beyond the code" class="pt-14 pb-10 sm:pt-20 sm:pb-16">
  <div class="max-w-4xl mx-auto px-6">
    <h2 data-animate="fade-up" class="text-4xl sm:text-5xl font-bold text-text-primary mb-16">Beyond the Code</h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {cards.map((card) => (
        <div
          data-animate="fade-up"
          class="bg-bg-surface border border-border-subtle rounded-lg p-6 sm:p-8 relative overflow-hidden min-h-[220px] card-hover"
        >
          <div class="absolute -bottom-4 -right-4 w-[200px] h-[200px] opacity-[0.12] pointer-events-none">
            <Image
              src={card.image}
              alt=""
              width={200}
              height={200}
              loading="lazy"
              class="object-contain w-full h-full dark-only"
            />
            <Image
              src={card.imageLight}
              alt=""
              width={200}
              height={200}
              loading="lazy"
              class="object-contain w-full h-full light-only"
            />
          </div>
          <div class="relative z-10">
            <h3 class="text-lg font-semibold text-text-primary mb-3">{card.title}</h3>
            <p class="text-text-secondary text-sm leading-relaxed md:pr-4" set:html={card.text} />
            {card.link && (
              <a
                href={card.link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-block mt-3 text-sm text-accent-functional hover:text-accent-light transition-colors external-link"
              >
                {card.link.label}<span class="sr-only"> (opens in new tab)</span>
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

---
---

<section class="relative isolate min-h-screen flex items-center justify-center overflow-hidden">
  {/* Animated canvas background */}
  <canvas
    id="hero-canvas"
    class="absolute inset-0 z-0 w-full h-full"
  />
  {/* Bottom fade to seamlessly blend into the next section */}
  <div
    class="absolute inset-0 z-[1] pointer-events-none"
    style="background: linear-gradient(to bottom, transparent 70%, #0a0a0a 100%);"
  />

  <div class="text-center px-6 relative z-10">
    <h1
      data-animate="hero"
      class="hero-title text-7xl sm:text-8xl lg:text-9xl font-bold tracking-tight"
    >
      Viv.
    </h1>
    <p
      data-animate="hero"
      class="mt-6 text-xl sm:text-2xl text-text-secondary max-w-xl mx-auto"
    >
      Software engineer. Building things that matter.
    </p>
  </div>

  {/* Scroll indicator */}
  <div
    data-animate="hero"
    class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 z-10"
  >
    <span class="text-xs text-text-tertiary tracking-widest uppercase">Scroll</span>
    <svg
      class="w-5 h-5 text-text-tertiary animate-bounce"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>

<style>
  .hero-title {
    background: linear-gradient(
      90deg,
      #f0eaff 0%,
      #ffffff 20%,
      #C4B5FD 40%,
      #7C3AED 60%,
      #ffffff 80%,
      #f0eaff 100%
    );
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradient-shift 20s ease-in-out infinite;
    filter:
      drop-shadow(0 0 40px rgba(124, 58, 237, 0.25))
      drop-shadow(0 0 80px rgba(139, 92, 246, 0.1));
  }

  @keyframes gradient-shift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title {
      animation: none;
      background-position: 50% 50%;
    }
  }
</style>

<script>
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Configuration
    const PARTICLE_COUNT = 120;
    const CONNECTION_DISTANCE = 180;
    const MOUSE_RADIUS = 250;
    const BASE_SPEED = 0.4;

    // Colours (violet accent family)
    const VIOLET_BRAND = { r: 124, g: 58, b: 237 };   // #7C3AED
    const VIOLET_LIGHT = { r: 167, g: 139, b: 250 };   // #A78BFA

    let width = 0;
    let height = 0;
    let mouseX = -1000;
    let mouseY = -1000;
    let animationId: number;

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      brightness: number; // 0-1, affects which colour shade
    }

    const particles: Particle[] = [];

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
    }

    function createParticles() {
      particles.length = 0;
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * BASE_SPEED * 2,
          vy: (Math.random() - 0.5) * BASE_SPEED * 2,
          radius: Math.random() * 2.5 + 1,
          brightness: Math.random(),
        });
      }
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);

      // Fill background
      ctx.fillStyle = '#0a0a0a';
      ctx.fillRect(0, 0, width, height);

      // Draw subtle radial glow behind the centre
      const centreGlow = ctx.createRadialGradient(
        width * 0.5, height * 0.45, 0,
        width * 0.5, height * 0.45, Math.max(width, height) * 0.6
      );
      centreGlow.addColorStop(0, 'rgba(124, 58, 237, 0.07)');
      centreGlow.addColorStop(0.4, 'rgba(124, 58, 237, 0.03)');
      centreGlow.addColorStop(1, 'transparent');
      ctx.fillStyle = centreGlow;
      ctx.fillRect(0, 0, width, height);

      // Draw connections between nearby particles
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < CONNECTION_DISTANCE) {
            const opacity = (1 - dist / CONNECTION_DISTANCE) * 0.35;
            ctx.strokeStyle = `rgba(${VIOLET_BRAND.r}, ${VIOLET_BRAND.g}, ${VIOLET_BRAND.b}, ${opacity})`;
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      // Draw mouse connections
      if (mouseX > 0 && mouseY > 0) {
        for (const p of particles) {
          const dx = mouseX - p.x;
          const dy = mouseY - p.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < MOUSE_RADIUS) {
            const opacity = (1 - dist / MOUSE_RADIUS) * 0.5;
            ctx.strokeStyle = `rgba(${VIOLET_LIGHT.r}, ${VIOLET_LIGHT.g}, ${VIOLET_LIGHT.b}, ${opacity})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(mouseX, mouseY);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
          }
        }
      }

      // Draw particles
      for (const p of particles) {
        // Interpolate colour based on brightness
        const r = Math.round(VIOLET_BRAND.r + (VIOLET_LIGHT.r - VIOLET_BRAND.r) * p.brightness);
        const g = Math.round(VIOLET_BRAND.g + (VIOLET_LIGHT.g - VIOLET_BRAND.g) * p.brightness);
        const b = Math.round(VIOLET_BRAND.b + (VIOLET_LIGHT.b - VIOLET_BRAND.b) * p.brightness);

        // Glow
        const glow = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, p.radius * 6);
        glow.addColorStop(0, `rgba(${r}, ${g}, ${b}, 0.6)`);
        glow.addColorStop(0.4, `rgba(${r}, ${g}, ${b}, 0.15)`);
        glow.addColorStop(1, 'transparent');
        ctx.fillStyle = glow;
        ctx.fillRect(p.x - p.radius * 6, p.y - p.radius * 6, p.radius * 12, p.radius * 12);

        // Core
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, 1)`;
        ctx.fill();
      }
    }

    function update() {
      for (const p of particles) {
        // Mouse repulsion (gentle)
        if (mouseX > 0 && mouseY > 0) {
          const dx = p.x - mouseX;
          const dy = p.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MOUSE_RADIUS && dist > 0) {
            const force = (1 - dist / MOUSE_RADIUS) * 0.5;
            p.vx += (dx / dist) * force;
            p.vy += (dy / dist) * force;
          }
        }

        // Apply velocity with damping
        p.vx *= 0.99;
        p.vy *= 0.99;

        // Clamp speed
        const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
        if (speed > BASE_SPEED * 3) {
          p.vx = (p.vx / speed) * BASE_SPEED * 3;
          p.vy = (p.vy / speed) * BASE_SPEED * 3;
        }

        // Ensure minimum drift
        if (speed < BASE_SPEED * 0.5) {
          p.vx += (Math.random() - 0.5) * 0.1;
          p.vy += (Math.random() - 0.5) * 0.1;
        }

        p.x += p.vx;
        p.y += p.vy;

        // Wrap around edges with padding
        const pad = 50;
        if (p.x < -pad) p.x = width + pad;
        if (p.x > width + pad) p.x = -pad;
        if (p.y < -pad) p.y = height + pad;
        if (p.y > height + pad) p.y = -pad;
      }
    }

    function animate() {
      update();
      draw();
      animationId = requestAnimationFrame(animate);
    }

    // Static render for reduced motion
    function drawStatic() {
      draw();
    }

    // Event listeners
    window.addEventListener('resize', () => {
      resize();
      if (prefersReducedMotion) drawStatic();
    });

    let isDragging = false;
    let dragMoved = false;
    let dragThrottle = 0;
    const DRAG_SPAWN_INTERVAL = 40; // ms between trail particles

    const heroSection = canvas.closest('section')!;

    heroSection.addEventListener('mousemove', (e: Event) => {
      const me = e as MouseEvent;
      const rect = canvas.getBoundingClientRect();
      mouseX = me.clientX - rect.left;
      mouseY = me.clientY - rect.top;

      // Paint trail particles while dragging
      if (isDragging) {
        dragMoved = true;
        const now = performance.now();
        if (now - dragThrottle > DRAG_SPAWN_INTERVAL) {
          dragThrottle = now;
          // Spawn a particle drifting perpendicular to the drag direction
          const angle = Math.random() * Math.PI * 2;
          const speed = BASE_SPEED * (0.3 + Math.random() * 0.5);
          particles.push({
            x: mouseX + (Math.random() - 0.5) * 8,
            y: mouseY + (Math.random() - 0.5) * 8,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            radius: Math.random() * 2 + 1.5,
            brightness: 0.8 + Math.random() * 0.2,
          });
        }
      }
    });

    heroSection.addEventListener('mouseleave', () => {
      mouseX = -1000;
      mouseY = -1000;
      isDragging = false;
    });

    heroSection.addEventListener('mousedown', () => {
      isDragging = true;
      dragMoved = false;
      dragThrottle = 0;
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    heroSection.addEventListener('click', (e: Event) => {
      // Don't burst-spawn if the user was dragging
      if (dragMoved) return;

      const me = e as MouseEvent;
      const rect = canvas.getBoundingClientRect();
      const cx = me.clientX - rect.left;
      const cy = me.clientY - rect.top;

      // Spawn a burst of new particles at the click location
      const BURST_COUNT = 5;
      for (let i = 0; i < BURST_COUNT; i++) {
        const angle = (Math.PI * 2 * i) / BURST_COUNT;
        const speed = BASE_SPEED * (1.5 + Math.random());
        particles.push({
          x: cx,
          y: cy,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          radius: Math.random() * 2.5 + 1,
          brightness: 0.7 + Math.random() * 0.3,
        });
      }
    });

    // Initialise
    resize();
    createParticles();

    if (prefersReducedMotion) {
      drawStatic();
    } else {
      animate();
    }

    // Clean up when navigating away
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationId);
    });
  }
</script>

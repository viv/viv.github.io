---
---

<button
  type="button"
  aria-label="Toggle light and dark mode"
  class="theme-toggle-btn relative w-9 h-9 flex items-center justify-center rounded-lg bg-transparent border-none text-text-secondary hover:text-text-primary hover:bg-bg-raised transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
>
  {/* Sun icon (shown in dark mode, click to go light) */}
  <svg
    class="theme-icon theme-icon--sun w-5 h-5 absolute"
    aria-hidden="true"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
    />
  </svg>
  {/* Moon icon (shown in light mode, click to go dark) */}
  <svg
    class="theme-icon theme-icon--moon w-5 h-5 absolute"
    aria-hidden="true"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="1.5"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
    />
  </svg>
</button>

<style>
  /* Default: dark mode — show sun icon, hide moon */
  .theme-icon--sun {
    opacity: 1;
    transform: rotate(0deg) scale(1);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
  .theme-icon--moon {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* Light mode — show moon icon, hide sun */
  :global(html[data-theme="light"]) .theme-icon--sun {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }
  :global(html[data-theme="light"]) .theme-icon--moon {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>

<script>
  const toggles = document.querySelectorAll<HTMLButtonElement>('.theme-toggle-btn');

  function getTheme(): 'dark' | 'light' {
    return document.documentElement.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
  }

  function updateLabels(theme: 'dark' | 'light') {
    const label = theme === 'dark' ? 'Switch to light mode' : 'Switch to dark mode';
    toggles.forEach((btn) => btn.setAttribute('aria-label', label));
  }

  function setTheme(theme: 'dark' | 'light') {
    if (theme === 'light') {
      document.documentElement.setAttribute('data-theme', 'light');
    } else {
      document.documentElement.removeAttribute('data-theme');
    }
    localStorage.setItem('theme', theme);
    updateLabels(theme);

    // Dispatch a custom event so other components (e.g. hero canvas) can react
    window.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
  }

  // Set initial label based on current theme
  updateLabels(getTheme());

  toggles.forEach((btn) => {
    btn.addEventListener('click', () => {
      const current = getTheme();
      setTheme(current === 'dark' ? 'light' : 'dark');
    });
  });

</script>

---
const year = new Date().getFullYear();
---

<footer id="contact" class="py-24 sm:py-32 border-t border-border-subtle">
  <div class="max-w-4xl mx-auto px-6 text-center">
    <h2 class="text-3xl sm:text-4xl font-bold text-text-primary mb-6">Want to talk?</h2>
    <p class="text-lg text-text-secondary mb-8">
      Find me on{' '}
      <a
        href="https://github.com/viv"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent-functional hover:text-accent-light transition-colors underline underline-offset-4"
      >
        GitHub
      </a>{' '}
      or{' '}
      <a
        href="https://www.linkedin.com/in/bmvivian"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent-functional hover:text-accent-light transition-colors underline underline-offset-4"
      >
        LinkedIn
      </a>.
    </p>

    <p class="text-sm text-text-tertiary mb-2">South Wales</p>

    <a
      href="/ai-engineering"
      class="inline-block text-sm text-accent-functional hover:text-accent-light transition-colors mb-12"
    >
      AI Engineering &rarr;
    </a>

    <p class="text-xs text-text-tertiary">
      &copy; {year} Matthew Vivian. All rights reserved.
    </p>
  </div>
</footer>

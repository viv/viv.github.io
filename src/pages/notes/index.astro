---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import {getCollection} from 'astro:content';

const notes = (await getCollection('notes')).sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Field Notes — Viv"
            description="A working engineer's notebook. Learnings, configurations, observations, and the occasional war story.">
    <Navigation/>

    <main id="main-content" class="relative pt-24 pb-32">
        <div aria-hidden="true" class="reading-glow"></div>
        <div class="relative z-10 max-w-3xl mx-auto px-6">
            <a href="/"
               class="text-sm text-accent-functional hover:text-accent-light transition-colors mb-8 inline-block">&larr;
                Back to main</a>

            <h1 class="text-4xl sm:text-5xl font-bold text-text-primary mb-4">Field Notes</h1>
            <p class="text-lg text-text-secondary leading-relaxed mb-16">
                My engineering notebook. Discoveries, observations, failures, and ideas I've been pondering.
            </p>

            {notes.length === 0 ? (
                    <p class="text-text-tertiary italic">No notes yet. Check back soon.</p>
            ) : (
                    <ul class="space-y-8">
                        {notes.map((note) => (
                                <li class="group">
                                    <a
                                            href={`/notes/${note.id}`}
                                            class="block"
                                    >
                                        <time
                                                datetime={note.data.date.toISOString().slice(0, 10)}
                                                class="text-sm text-text-tertiary font-mono"
                                        >
                                            {note.data.date.toISOString().slice(0, 10)}
                                        </time>
                                        <h2 class="text-2xl font-semibold text-text-primary group-hover:text-accent transition-colors mt-1">
                                            {note.data.title}
                                        </h2>
                                        {note.data.description && (
                                                <p class="text-lg text-text-secondary mt-1">{note.data.description}</p>
                                        )}
                                    </a>
                                    {note.data.tags && note.data.tags.length > 0 && (
                                            <div class="flex flex-wrap gap-2 mt-2">
                                                {note.data.tags.map((tag: string) => (
                                                        <a
                                                                href={`/notes/tags/${tag}`}
                                                                class="text-xs font-mono text-accent-functional bg-bg-surface border border-border-subtle rounded px-2 py-0.5 hover:border-accent/40 transition-colors"
                                                        >
                                                            {tag}
                                                        </a>
                                                ))}
                                            </div>
                                    )}
                                </li>
                        ))}
                    </ul>
            )}

            <div class="border-t border-border-subtle pt-8 mt-16 flex items-center justify-between">
                <a href="/" class="text-sm text-accent-functional hover:text-accent-light transition-colors">&larr; Back
                    to main</a>
                <a href="/notes/rss.xml"
                   class="text-sm text-accent-functional hover:text-accent-light transition-colors">RSS Feed &rarr;</a>
            </div>
        </div>
    </main>
</BaseLayout>

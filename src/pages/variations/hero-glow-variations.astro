---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import { Image } from 'astro:assets';
import avatar from '../../assets/headshot/avatar.png';
---

<BaseLayout title="Hero Glow Variations — Viv" description="Radial glow at different intensities — no particles.">
  <Navigation />

  {/* ── VARIATION 1: Full glow (matching combined CSS + canvas intensity) ── */}
  <section id="glow-full" aria-label="Full glow" class="relative isolate min-h-[80vh] flex items-center pt-16 sm:pt-24 pb-16 sm:pb-24 overflow-hidden">
    <div aria-hidden="true" class="absolute inset-0 z-0 bg-blueprint"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--tl"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--tr"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--bl"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--br"></div>
    <div aria-hidden="true" class="absolute inset-0 z-[1] bg-glow-full"></div>
    <div aria-hidden="true" class="hero-bottom-fade absolute inset-0 z-[2] pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-6 w-full relative z-10">
      <div class="text-center mb-8">
        <span class="inline-block px-3 py-1 mb-6 text-xs font-mono tracking-widest uppercase bg-accent/10 text-accent border border-accent/20 rounded-full">Variation 1 — Full Glow</span>
        <p class="text-sm text-text-secondary">Combined CSS + canvas intensity. Centre 0.13, mid 0.05.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-12 lg:gap-20 items-center">
        <div class="text-center lg:text-left">
          <Image
            src={avatar}
            alt="Viv — portrait photo"
            width={160}
            height={160}
            class="w-28 h-28 sm:w-40 sm:h-40 rounded-full border-2 border-border-subtle mx-auto lg:mx-0 mb-8"
          />
          <h1 class="hero-title text-6xl sm:text-7xl md:text-8xl font-bold tracking-tight">Viv.</h1>
          <p class="mt-3 text-lg text-text-secondary max-w-[80vw] sm:max-w-[60vw] lg:max-w-[18rem] text-center lg:text-left mx-auto lg:mx-0">
            Software engineer. 25 years understanding systems, users, and problems.
          </p>
        </div>
        <div class="space-y-6">
          <p class="text-base lg:text-lg text-text-primary leading-relaxed">
            I've been writing software since the late 90s. In that time I've learned that tools change constantly but the principles of good engineering don't.
          </p>
          <p class="text-base lg:text-lg text-text-primary leading-relaxed">
            These days I'm deeply focused on how AI is reshaping the craft of software engineering. Not replacing what experienced engineers do, but amplifying it in ways I find genuinely exciting.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── VARIATION 2: Medium glow (~60% of full) ── */}
  <section id="glow-medium" aria-label="Medium glow" class="relative isolate min-h-[80vh] flex items-center pt-16 sm:pt-24 pb-16 sm:pb-24 overflow-hidden">
    <div aria-hidden="true" class="absolute inset-0 z-0 bg-blueprint"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--tl"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--tr"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--bl"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--br"></div>
    <div aria-hidden="true" class="absolute inset-0 z-[1] bg-glow-medium"></div>
    <div aria-hidden="true" class="hero-bottom-fade absolute inset-0 z-[2] pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-6 w-full relative z-10">
      <div class="text-center mb-8">
        <span class="inline-block px-3 py-1 mb-6 text-xs font-mono tracking-widest uppercase bg-accent/10 text-accent border border-accent/20 rounded-full">Variation 2 — Medium Glow</span>
        <p class="text-sm text-text-secondary">About 60% of full. Centre 0.08, mid 0.03.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-12 lg:gap-20 items-center">
        <div class="text-center lg:text-left">
          <Image
            src={avatar}
            alt="Viv — portrait photo"
            width={160}
            height={160}
            class="w-28 h-28 sm:w-40 sm:h-40 rounded-full border-2 border-border-subtle mx-auto lg:mx-0 mb-8"
          />
          <h1 class="hero-title text-6xl sm:text-7xl md:text-8xl font-bold tracking-tight">Viv.</h1>
          <p class="mt-3 text-lg text-text-secondary max-w-[80vw] sm:max-w-[60vw] lg:max-w-[18rem] text-center lg:text-left mx-auto lg:mx-0">
            Software engineer. 25 years understanding systems, users, and problems.
          </p>
        </div>
        <div class="space-y-6">
          <p class="text-base lg:text-lg text-text-primary leading-relaxed">
            I've been writing software since the late 90s. In that time I've learned that tools change constantly but the principles of good engineering don't.
          </p>
          <p class="text-base lg:text-lg text-text-primary leading-relaxed">
            These days I'm deeply focused on how AI is reshaping the craft of software engineering. Not replacing what experienced engineers do, but amplifying it in ways I find genuinely exciting.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── VARIATION 3: Subtle glow (~30% of full) ── */}
  <section id="glow-subtle" aria-label="Subtle glow" class="relative isolate min-h-[80vh] flex items-center pt-16 sm:pt-24 pb-16 sm:pb-24 overflow-hidden">
    <div aria-hidden="true" class="absolute inset-0 z-0 bg-blueprint"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--tl"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--tr"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--bl"></div>
    <div aria-hidden="true" class="blueprint-corner blueprint-corner--br"></div>
    <div aria-hidden="true" class="absolute inset-0 z-[1] bg-glow-subtle"></div>
    <div aria-hidden="true" class="hero-bottom-fade absolute inset-0 z-[2] pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-6 w-full relative z-10">
      <div class="text-center mb-8">
        <span class="inline-block px-3 py-1 mb-6 text-xs font-mono tracking-widest uppercase bg-accent/10 text-accent border border-accent/20 rounded-full">Variation 3 — Subtle Glow</span>
        <p class="text-sm text-text-secondary">About 30% of full. Centre 0.04, mid 0.015.</p>
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-12 lg:gap-20 items-center">
        <div class="text-center lg:text-left">
          <Image
            src={avatar}
            alt="Viv — portrait photo"
            width={160}
            height={160}
            class="w-28 h-28 sm:w-40 sm:h-40 rounded-full border-2 border-border-subtle mx-auto lg:mx-0 mb-8"
          />
          <h1 class="hero-title text-6xl sm:text-7xl md:text-8xl font-bold tracking-tight">Viv.</h1>
          <p class="mt-3 text-lg text-text-secondary max-w-[80vw] sm:max-w-[60vw] lg:max-w-[18rem] text-center lg:text-left mx-auto lg:mx-0">
            Software engineer. 25 years understanding systems, users, and problems.
          </p>
        </div>
        <div class="space-y-6">
          <p class="text-base lg:text-lg text-text-primary leading-relaxed">
            I've been writing software since the late 90s. In that time I've learned that tools change constantly but the principles of good engineering don't.
          </p>
          <p class="text-base lg:text-lg text-text-primary leading-relaxed">
            These days I'm deeply focused on how AI is reshaping the craft of software engineering. Not replacing what experienced engineers do, but amplifying it in ways I find genuinely exciting.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Jump nav */}
  <div class="py-8 bg-bg-surface border-t border-b border-border-subtle">
    <div class="max-w-3xl mx-auto px-6 flex flex-wrap items-center justify-center gap-6 text-sm">
      <span class="text-text-tertiary">Jump to:</span>
      <a href="#glow-full" class="text-accent-functional hover:text-accent-light transition-colors link-hover">Full</a>
      <a href="#glow-medium" class="text-accent-functional hover:text-accent-light transition-colors link-hover">Medium</a>
      <a href="#glow-subtle" class="text-accent-functional hover:text-accent-light transition-colors link-hover">Subtle</a>
      <span class="text-border-emphasis">|</span>
      <a href="/variations" class="text-accent-functional hover:text-accent-light transition-colors link-hover">&larr; Back to Variations</a>
    </div>
  </div>
</BaseLayout>

<style>
  .hero-title {
    color: #ffffff;
  }

  :global(html[data-theme="light"]) .hero-title {
    color: #1a1a1a;
  }

  .hero-bottom-fade {
    background: linear-gradient(to bottom, transparent 70%, var(--color-bg) 100%);
  }

  /* Blueprint grid background (matches Hero.astro) */
  .bg-blueprint {
    background-color: #0d0a1a;
    background-image:
      repeating-linear-gradient(0deg, rgba(141, 127, 210, 0.15) 0px, rgba(141, 127, 210, 0.15) 1px, transparent 1px, transparent 160px),
      repeating-linear-gradient(90deg, rgba(141, 127, 210, 0.15) 0px, rgba(141, 127, 210, 0.15) 1px, transparent 1px, transparent 160px),
      repeating-linear-gradient(0deg, rgba(141, 127, 210, 0.06) 0px, rgba(141, 127, 210, 0.06) 1px, transparent 1px, transparent 32px),
      repeating-linear-gradient(90deg, rgba(141, 127, 210, 0.06) 0px, rgba(141, 127, 210, 0.06) 1px, transparent 1px, transparent 32px);
  }

  :global(html[data-theme="light"]) .bg-blueprint {
    background-color: #f5f3fa;
    background-image:
      repeating-linear-gradient(0deg, rgba(70, 51, 163, 0.15) 0px, rgba(70, 51, 163, 0.15) 1px, transparent 1px, transparent 160px),
      repeating-linear-gradient(90deg, rgba(70, 51, 163, 0.15) 0px, rgba(70, 51, 163, 0.15) 1px, transparent 1px, transparent 160px),
      repeating-linear-gradient(0deg, rgba(70, 51, 163, 0.06) 0px, rgba(70, 51, 163, 0.06) 1px, transparent 1px, transparent 32px),
      repeating-linear-gradient(90deg, rgba(70, 51, 163, 0.06) 0px, rgba(70, 51, 163, 0.06) 1px, transparent 1px, transparent 32px);
  }

  /* Blueprint corner markers */
  .blueprint-corner {
    position: absolute;
    width: 40px;
    height: 40px;
    z-index: 3;
    pointer-events: none;
  }

  .blueprint-corner--tl {
    top: 60px;
    left: 40px;
    border-top: 2px solid rgba(141, 127, 210, 0.15);
    border-left: 2px solid rgba(141, 127, 210, 0.15);
  }

  .blueprint-corner--tr {
    top: 60px;
    right: 40px;
    border-top: 2px solid rgba(141, 127, 210, 0.15);
    border-right: 2px solid rgba(141, 127, 210, 0.15);
  }

  .blueprint-corner--bl {
    bottom: 40px;
    left: 40px;
    border-bottom: 2px solid rgba(141, 127, 210, 0.15);
    border-left: 2px solid rgba(141, 127, 210, 0.15);
  }

  .blueprint-corner--br {
    bottom: 40px;
    right: 40px;
    border-bottom: 2px solid rgba(141, 127, 210, 0.15);
    border-right: 2px solid rgba(141, 127, 210, 0.15);
  }

  :global(html[data-theme="light"]) .blueprint-corner--tl,
  :global(html[data-theme="light"]) .blueprint-corner--tr,
  :global(html[data-theme="light"]) .blueprint-corner--bl,
  :global(html[data-theme="light"]) .blueprint-corner--br {
    border-color: rgba(70, 51, 163, 0.2);
  }

  /* ═══════════════════════════════════════════════
     Glow variations — CSS-only radial gradients
     ═══════════════════════════════════════════════ */

  /* Full glow — matches combined CSS glow + canvas centre glow */
  .bg-glow-full {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(141, 127, 210, 0.13) 0%,
      rgba(141, 127, 210, 0.05) 40%,
      transparent 70%
    );
  }

  :global(html[data-theme="light"]) .bg-glow-full {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(70, 51, 163, 0.09) 0%,
      rgba(70, 51, 163, 0.035) 40%,
      transparent 70%
    );
  }

  /* Medium glow — ~60% of full */
  .bg-glow-medium {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(141, 127, 210, 0.08) 0%,
      rgba(141, 127, 210, 0.03) 40%,
      transparent 70%
    );
  }

  :global(html[data-theme="light"]) .bg-glow-medium {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(70, 51, 163, 0.055) 0%,
      rgba(70, 51, 163, 0.02) 40%,
      transparent 70%
    );
  }

  /* Subtle glow — ~30% of full */
  .bg-glow-subtle {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(141, 127, 210, 0.04) 0%,
      rgba(141, 127, 210, 0.015) 40%,
      transparent 70%
    );
  }

  :global(html[data-theme="light"]) .bg-glow-subtle {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(70, 51, 163, 0.03) 0%,
      rgba(70, 51, 163, 0.01) 40%,
      transparent 70%
    );
  }
</style>

---
// HERO TEST 3A: Integrated hero+about with interactive particle canvas background
// Based on hero-test-3 layout (name+avatar left, about text right)
// Adds: particle canvas from Hero.astro, animated gradient "Viv." text,
// smooth bottom fade into next section
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navigation from '../../components/Navigation.astro';
import { Image } from 'astro:assets';
import avatar from '../../assets/headshot/avatar.png';
import Timeline from '../../components/Timeline.astro';
import Expertise from '../../components/Expertise.astro';
import WorkInTheOpen from '../../components/WorkInTheOpen.astro';
import BeyondTheCode from '../../components/BeyondTheCode.astro';
import Contact from '../../components/Contact.astro';
---

<BaseLayout title="Viv — Software Engineer">
  <Navigation />
  <main id="main-content">
    {/* Combined hero + about with particle canvas */}
    <section id="about" aria-label="About" class="relative isolate min-h-[80vh] flex items-center pt-16 pb-32 overflow-hidden">
      {/* Animated canvas background — decorative, hidden from assistive tech */}
      <canvas
        id="hero-canvas"
        aria-hidden="true"
        class="absolute inset-0 z-0 w-full h-full"
      />
      {/* Bottom fade to seamlessly blend into the next section */}
      <div
        aria-hidden="true"
        class="hero-bottom-fade absolute inset-0 z-[1] pointer-events-none"
      />

      <div class="max-w-5xl mx-auto px-6 w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-12 lg:gap-20 items-center">
          {/* Left: name + avatar */}
          <div class="text-center lg:text-left">
            <Image
              src={avatar}
              alt="Viv — portrait photo"
              width={160}
              height={160}
              class="w-28 h-28 sm:w-40 sm:h-40 rounded-full border-2 border-border-subtle mx-auto lg:mx-0 mb-8"
            />
            <h1 class="hero-title text-6xl sm:text-7xl md:text-8xl font-bold tracking-tight">
              Viv.
            </h1>
            <p class="mt-3 text-lg text-text-secondary">
              Software engineer.<br />Building things that matter.
            </p>
          </div>

          {/* Right: about text */}
          <div class="space-y-6">
            <p data-animate="fade-up" class="text-lg text-text-primary leading-relaxed">
              I've been writing software since the late 90s. In that time I've learned that tools change constantly but the principles of good engineering don't.
            </p>
            <p data-animate="fade-up" class="text-lg text-text-primary leading-relaxed">
              I'm a Chartered Engineer and a member of the BCS, and I studied Computer Science at Cardiff University. I live in South Wales and I've worked remotely for most of my career, long before it was fashionable. Most of my career has been spent building systems where the stakes are high — national cyber security infrastructure, government services, child safeguarding platforms, identity verification at scale.
            </p>
            <p data-animate="fade-up" class="text-lg text-text-primary leading-relaxed">
              These days I'm deeply focused on how AI is reshaping the craft of software engineering. Not replacing what experienced engineers do, but amplifying it in ways I find genuinely exciting. After more than 25 years, this is the most significant shift I've seen.
            </p>
          </div>
        </div>
      </div>
    </section>

    <Timeline />
    <Expertise />
    <WorkInTheOpen />
    <BeyondTheCode />
  </main>
  <Contact />
</BaseLayout>

<style>
  .hero-bottom-fade {
    background: linear-gradient(to bottom, transparent 60%, var(--color-bg) 100%);
  }

  .hero-title {
    background: linear-gradient(
      90deg,
      #f0eaff 0%,
      #ffffff 20%,
      #C4B5FD 40%,
      #A78BFA 60%,
      #ffffff 80%,
      #f0eaff 100%
    );
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: gradient-shift 20s ease-in-out infinite;
    filter:
      drop-shadow(0 0 40px rgba(124, 58, 237, 0.25))
      drop-shadow(0 0 80px rgba(139, 92, 246, 0.1));
  }

  /* Light mode: darker gradient text for readability against light canvas */
  :global(html[data-theme="light"]) .hero-title {
    background: linear-gradient(
      90deg,
      #4C1D95 0%,
      #1a1a1a 20%,
      #7C3AED 40%,
      #6D28D9 60%,
      #1a1a1a 80%,
      #4C1D95 100%
    );
    background-size: 300% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    filter:
      drop-shadow(0 0 40px rgba(124, 58, 237, 0.15))
      drop-shadow(0 0 80px rgba(139, 92, 246, 0.05));
  }

  @keyframes gradient-shift {
    0% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
    100% { background-position: 0% 50%; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-title {
      animation: none;
      background-position: 50% 50%;
    }
  }
</style>

<script>
  // Interactive particle canvas — full implementation from Hero.astro
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Configuration
    const PARTICLE_COUNT = 120;
    const CONNECTION_DISTANCE = 180;
    const MOUSE_RADIUS = 250;
    const BASE_SPEED = 0.4;

    // Colours (violet accent family)
    const VIOLET_BRAND = { r: 124, g: 58, b: 237 };   // #7C3AED
    const VIOLET_LIGHT = { r: 167, g: 139, b: 250 };   // #A78BFA

    function getBgColour(): string {
      return getComputedStyle(document.documentElement).getPropertyValue('--color-bg').trim();
    }

    function isLightMode(): boolean {
      return document.documentElement.getAttribute('data-theme') === 'light';
    }

    let width = 0;
    let height = 0;
    let mouseX = -1000;
    let mouseY = -1000;
    let animationId: number;

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      brightness: number;
    }

    const particles: Particle[] = [];

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
    }

    function createParticles() {
      particles.length = 0;
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * BASE_SPEED * 2,
          vy: (Math.random() - 0.5) * BASE_SPEED * 2,
          radius: Math.random() * 2.5 + 1,
          brightness: Math.random(),
        });
      }
    }

    function draw() {
      ctx.clearRect(0, 0, width, height);

      // Fill background from CSS variable (reacts to theme changes)
      ctx.fillStyle = getBgColour();
      ctx.fillRect(0, 0, width, height);

      // Draw subtle radial glow behind the centre
      const glowOpacity = isLightMode() ? 0.05 : 0.07;
      const glowOpacityOuter = isLightMode() ? 0.02 : 0.03;
      const centreGlow = ctx.createRadialGradient(
        width * 0.5, height * 0.45, 0,
        width * 0.5, height * 0.45, Math.max(width, height) * 0.6
      );
      centreGlow.addColorStop(0, `rgba(124, 58, 237, ${glowOpacity})`);
      centreGlow.addColorStop(0.4, `rgba(124, 58, 237, ${glowOpacityOuter})`);
      centreGlow.addColorStop(1, 'transparent');
      ctx.fillStyle = centreGlow;
      ctx.fillRect(0, 0, width, height);

      // Draw connections between nearby particles
      const light = isLightMode();
      const connectionAlpha = light ? 0.2 : 0.35;
      const mouseAlpha = light ? 0.35 : 0.5;

      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < CONNECTION_DISTANCE) {
            const opacity = (1 - dist / CONNECTION_DISTANCE) * connectionAlpha;
            ctx.strokeStyle = `rgba(${VIOLET_BRAND.r}, ${VIOLET_BRAND.g}, ${VIOLET_BRAND.b}, ${opacity})`;
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      // Draw mouse connections
      if (mouseX > 0 && mouseY > 0) {
        for (const p of particles) {
          const dx = mouseX - p.x;
          const dy = mouseY - p.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < MOUSE_RADIUS) {
            const opacity = (1 - dist / MOUSE_RADIUS) * mouseAlpha;
            ctx.strokeStyle = `rgba(${VIOLET_LIGHT.r}, ${VIOLET_LIGHT.g}, ${VIOLET_LIGHT.b}, ${opacity})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(mouseX, mouseY);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
          }
        }
      }

      // Draw particles
      for (const p of particles) {
        const r = Math.round(VIOLET_BRAND.r + (VIOLET_LIGHT.r - VIOLET_BRAND.r) * p.brightness);
        const g = Math.round(VIOLET_BRAND.g + (VIOLET_LIGHT.g - VIOLET_BRAND.g) * p.brightness);
        const b = Math.round(VIOLET_BRAND.b + (VIOLET_LIGHT.b - VIOLET_BRAND.b) * p.brightness);

        // Glow — softer and smaller on light backgrounds
        const glowRadius = light ? p.radius * 4 : p.radius * 6;
        const glowCore = light ? 0.25 : 0.6;
        const glowMid = light ? 0.06 : 0.15;
        const glow = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, glowRadius);
        glow.addColorStop(0, `rgba(${r}, ${g}, ${b}, ${glowCore})`);
        glow.addColorStop(0.3, `rgba(${r}, ${g}, ${b}, ${glowMid})`);
        glow.addColorStop(1, 'transparent');
        ctx.fillStyle = glow;
        ctx.fillRect(p.x - glowRadius, p.y - glowRadius, glowRadius * 2, glowRadius * 2);

        // Core
        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, 1)`;
        ctx.fill();
      }
    }

    function update() {
      for (const p of particles) {
        // Mouse repulsion (gentle)
        if (mouseX > 0 && mouseY > 0) {
          const dx = p.x - mouseX;
          const dy = p.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MOUSE_RADIUS && dist > 0) {
            const force = (1 - dist / MOUSE_RADIUS) * 0.5;
            p.vx += (dx / dist) * force;
            p.vy += (dy / dist) * force;
          }
        }

        // Apply velocity with damping
        p.vx *= 0.99;
        p.vy *= 0.99;

        // Clamp speed
        const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
        if (speed > BASE_SPEED * 3) {
          p.vx = (p.vx / speed) * BASE_SPEED * 3;
          p.vy = (p.vy / speed) * BASE_SPEED * 3;
        }

        // Ensure minimum drift
        if (speed < BASE_SPEED * 0.5) {
          p.vx += (Math.random() - 0.5) * 0.1;
          p.vy += (Math.random() - 0.5) * 0.1;
        }

        p.x += p.vx;
        p.y += p.vy;

        // Wrap around edges with padding
        const pad = 50;
        if (p.x < -pad) p.x = width + pad;
        if (p.x > width + pad) p.x = -pad;
        if (p.y < -pad) p.y = height + pad;
        if (p.y > height + pad) p.y = -pad;
      }
    }

    function animate() {
      update();
      draw();
      animationId = requestAnimationFrame(animate);
    }

    // Static render for reduced motion
    function drawStatic() {
      draw();
    }

    // Event listeners
    window.addEventListener('resize', () => {
      resize();
      if (prefersReducedMotion) drawStatic();
    });

    let isDragging = false;
    let dragMoved = false;
    let dragThrottle = 0;
    const DRAG_SPAWN_INTERVAL = 40;

    const heroSection = canvas.closest('section')!;

    heroSection.addEventListener('mousemove', (e: Event) => {
      const me = e as MouseEvent;
      const rect = canvas.getBoundingClientRect();
      mouseX = me.clientX - rect.left;
      mouseY = me.clientY - rect.top;

      // Paint trail particles while dragging
      if (isDragging) {
        dragMoved = true;
        const now = performance.now();
        if (now - dragThrottle > DRAG_SPAWN_INTERVAL) {
          dragThrottle = now;
          const angle = Math.random() * Math.PI * 2;
          const speed = BASE_SPEED * (0.3 + Math.random() * 0.5);
          particles.push({
            x: mouseX + (Math.random() - 0.5) * 8,
            y: mouseY + (Math.random() - 0.5) * 8,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            radius: Math.random() * 2 + 1.5,
            brightness: 0.8 + Math.random() * 0.2,
          });
        }
      }
    });

    heroSection.addEventListener('mouseleave', () => {
      mouseX = -1000;
      mouseY = -1000;
      isDragging = false;
    });

    heroSection.addEventListener('mousedown', () => {
      isDragging = true;
      dragMoved = false;
      dragThrottle = 0;
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    heroSection.addEventListener('click', (e: Event) => {
      if (dragMoved) return;

      const me = e as MouseEvent;
      const rect = canvas.getBoundingClientRect();
      const cx = me.clientX - rect.left;
      const cy = me.clientY - rect.top;

      const BURST_COUNT = 5;
      for (let i = 0; i < BURST_COUNT; i++) {
        const angle = (Math.PI * 2 * i) / BURST_COUNT;
        const speed = BASE_SPEED * (1.5 + Math.random());
        particles.push({
          x: cx,
          y: cy,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          radius: Math.random() * 2.5 + 1,
          brightness: 0.7 + Math.random() * 0.3,
        });
      }
    });

    // Initialise
    resize();
    createParticles();

    if (prefersReducedMotion) {
      drawStatic();
    } else {
      animate();
    }

    // Redraw immediately on theme change (for reduced-motion users)
    window.addEventListener('themechange', () => {
      if (prefersReducedMotion) drawStatic();
    });

    // Clean up when navigating away
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationId);
    });
  }
</script>

<script>
  // GSAP scroll animations
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!prefersReducedMotion) {
    gsap.utils.toArray('[data-animate="fade-up"]').forEach((el) => {
      gsap.from(el as Element, {
        scrollTrigger: { trigger: el as Element, start: 'top 85%', toggleActions: 'play none none none' },
        y: 30, opacity: 0, duration: 0.8, ease: 'power2.out',
      });
    });
    gsap.utils.toArray('[data-animate="timeline-entry"]').forEach((el) => {
      gsap.from(el as Element, {
        scrollTrigger: { trigger: el as Element, start: 'top 80%', toggleActions: 'play none none none' },
        y: 50, opacity: 0, duration: 1, ease: 'power3.out',
      });
    });
  }
</script>

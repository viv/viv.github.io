            <h1 class="hero-title text-6xl sm:text-7xl md:text-8xl font-bold tracking-tight">
              Viv.
            </h1>
            <p class="mt-3 text-lg text-text-secondary">
              Software engineer.<br />Building things that matter.
            </p>
          </div>
          <div class="space-y-6">
            <p class="text-lg text-text-primary leading-relaxed">
              I've been writing software since the late 90s. In that time I've learned that tools change constantly but the principles of good engineering don't.
            </p>
            <p class="text-lg text-text-primary leading-relaxed">
              I'm a Chartered Engineer and a member of the BCS, and I studied Computer Science at Cardiff University. I live in South Wales and I've worked remotely for most of my career, long before it was fashionable. Most of my career has been spent building systems where the stakes are high — national cyber security infrastructure, government services, child safeguarding platforms, identity verification at scale.
            </p>
            <p class="text-lg text-text-primary leading-relaxed">
              These days I'm deeply focused on how AI is reshaping the craft of software engineering. Not replacing what experienced engineers do, but amplifying it in ways I find genuinely exciting. After more than 25 years, this is the most significant shift I've seen.
            </p>
          </div>
        </div>
      </div>

      <div aria-hidden="true" class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 z-10">
        <span class="text-xs text-text-tertiary tracking-widest uppercase">Scroll</span>
        <svg class="w-5 h-5 text-text-tertiary animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </section>

  </main>
</BaseLayout>


<style>
  /* ──────────────────────────────────────
     Shared styles
     ────────────────────────────────────── */
  .hero-bottom-fade {
    background: linear-gradient(to bottom, transparent 60%, var(--color-bg) 100%);
  }

  .hero-title {
    color: #ffffff;
  }

  :global(html[data-theme="light"]) .hero-title {
    color: #1a1a1a;
  }

  /* ──────────────────────────────────────
     Variation 1 & 3 & 5: Graph Paper Grid
     Fine lines ~40px, major lines ~200px
     ────────────────────────────────────── */
  .bg-grid-paper {
    background-color: #0f1014;
    background-image:
      /* Major grid lines — 200px */
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.045) 0px,
        rgba(255, 255, 255, 0.045) 1px,
        transparent 1px,
        transparent 200px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.045) 0px,
        rgba(255, 255, 255, 0.045) 1px,
        transparent 1px,
        transparent 200px
      ),
      /* Fine grid lines — 40px */
      repeating-linear-gradient(
        0deg,
        rgba(255, 255, 255, 0.025) 0px,
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px,
        transparent 40px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(255, 255, 255, 0.025) 0px,
        rgba(255, 255, 255, 0.025) 1px,
        transparent 1px,
        transparent 40px
      );
  }

  :global(html[data-theme="light"]) .bg-grid-paper {
    background-color: #f5f5f0;
    background-image:
      repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.06) 0px,
        rgba(0, 0, 0, 0.06) 1px,
        transparent 1px,
        transparent 200px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.06) 0px,
        rgba(0, 0, 0, 0.06) 1px,
        transparent 1px,
        transparent 200px
      ),
      repeating-linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.03) 0px,
        rgba(0, 0, 0, 0.03) 1px,
        transparent 1px,
        transparent 40px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.03) 0px,
        rgba(0, 0, 0, 0.03) 1px,
        transparent 1px,
        transparent 40px
      );
  }

  /* Violet radial glow — used by variations 1 & 4 */
  .bg-glow-violet {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(124, 58, 237, 0.06) 0%,
      rgba(124, 58, 237, 0.02) 40%,
      transparent 70%
    );
  }

  :global(html[data-theme="light"]) .bg-glow-violet {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(124, 58, 237, 0.04) 0%,
      rgba(124, 58, 237, 0.01) 40%,
      transparent 70%
    );
  }


  /* ──────────────────────────────────────
     Variation 2: Blueprint
     Denser grid with blue/cyan tint
     ────────────────────────────────────── */
  .bg-blueprint {
    background-color: #0a0e1a;
    background-image:
      /* Major grid — 160px */
      repeating-linear-gradient(
        0deg,
        rgba(56, 189, 248, 0.08) 0px,
        rgba(56, 189, 248, 0.08) 1px,
        transparent 1px,
        transparent 160px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(56, 189, 248, 0.08) 0px,
        rgba(56, 189, 248, 0.08) 1px,
        transparent 1px,
        transparent 160px
      ),
      /* Fine grid — 32px */
      repeating-linear-gradient(
        0deg,
        rgba(56, 189, 248, 0.03) 0px,
        rgba(56, 189, 248, 0.03) 1px,
        transparent 1px,
        transparent 32px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(56, 189, 248, 0.03) 0px,
        rgba(56, 189, 248, 0.03) 1px,
        transparent 1px,
        transparent 32px
      );
  }

  :global(html[data-theme="light"]) .bg-blueprint {
    background-color: #f0f4ff;
    background-image:
      repeating-linear-gradient(
        0deg,
        rgba(37, 99, 235, 0.1) 0px,
        rgba(37, 99, 235, 0.1) 1px,
        transparent 1px,
        transparent 160px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(37, 99, 235, 0.1) 0px,
        rgba(37, 99, 235, 0.1) 1px,
        transparent 1px,
        transparent 160px
      ),
      repeating-linear-gradient(
        0deg,
        rgba(37, 99, 235, 0.04) 0px,
        rgba(37, 99, 235, 0.04) 1px,
        transparent 1px,
        transparent 32px
      ),
      repeating-linear-gradient(
        90deg,
        rgba(37, 99, 235, 0.04) 0px,
        rgba(37, 99, 235, 0.04) 1px,
        transparent 1px,
        transparent 32px
      );
  }

  /* Blueprint corner markers */
  .blueprint-corner {
    position: absolute;
    width: 40px;
    height: 40px;
    z-index: 1;
    pointer-events: none;
  }

  .blueprint-corner--tl {
    top: 60px;
    left: 40px;
    border-top: 2px solid rgba(56, 189, 248, 0.15);
    border-left: 2px solid rgba(56, 189, 248, 0.15);
  }

  .blueprint-corner--tr {
    top: 60px;
    right: 40px;
    border-top: 2px solid rgba(56, 189, 248, 0.15);
    border-right: 2px solid rgba(56, 189, 248, 0.15);
  }

  .blueprint-corner--bl {
    bottom: 40px;
    left: 40px;
    border-bottom: 2px solid rgba(56, 189, 248, 0.15);
    border-left: 2px solid rgba(56, 189, 248, 0.15);
  }

  .blueprint-corner--br {
    bottom: 40px;
    right: 40px;
    border-bottom: 2px solid rgba(56, 189, 248, 0.15);
    border-right: 2px solid rgba(56, 189, 248, 0.15);
  }

  :global(html[data-theme="light"]) .blueprint-corner--tl,
  :global(html[data-theme="light"]) .blueprint-corner--tr,
  :global(html[data-theme="light"]) .blueprint-corner--bl,
  :global(html[data-theme="light"]) .blueprint-corner--br {
    border-color: rgba(37, 99, 235, 0.2);
  }

  /* Blueprint radial glow — cyan/blue */
  .bg-glow-blueprint {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(56, 189, 248, 0.05) 0%,
      rgba(56, 189, 248, 0.015) 40%,
      transparent 70%
    );
  }

  :global(html[data-theme="light"]) .bg-glow-blueprint {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(37, 99, 235, 0.04) 0%,
      rgba(37, 99, 235, 0.01) 40%,
      transparent 70%
    );
  }


  /* ──────────────────────────────────────
     Variation 3: Animated breathing glow
     ────────────────────────────────────── */
  .bg-glow-breathing {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(124, 58, 237, 0.07) 0%,
      rgba(124, 58, 237, 0.025) 40%,
      transparent 70%
    );
    animation: glow-breathe 6s ease-in-out infinite;
  }

  :global(html[data-theme="light"]) .bg-glow-breathing {
    background: radial-gradient(
      ellipse 60% 50% at 50% 45%,
      rgba(124, 58, 237, 0.05) 0%,
      rgba(124, 58, 237, 0.015) 40%,
      transparent 70%
    );
  }

  @keyframes glow-breathe {
    0%, 100% {
      opacity: 0.6;
      transform: scale(1);
    }
    50% {
      opacity: 1;
      transform: scale(1.08);
    }
  }

  /* Respect reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .bg-glow-breathing {
      animation: none;
      opacity: 0.8;
    }
  }


  /* ──────────────────────────────────────
     Variation 4: Dot Matrix
     Tiny dots at grid intersections using radial-gradient
     ────────────────────────────────────── */
  .bg-dot-matrix {
    background-color: #0f1014;
    background-image:
      /* Major dots — every 200px, slightly larger & brighter */
      radial-gradient(circle 1.5px at 1.5px 1.5px, rgba(255, 255, 255, 0.12) 100%, transparent 100%),
      /* Fine dots — every 40px */
      radial-gradient(circle 0.8px at 0.8px 0.8px, rgba(255, 255, 255, 0.06) 100%, transparent 100%);
    background-size: 200px 200px, 40px 40px;
  }

  :global(html[data-theme="light"]) .bg-dot-matrix {
    background-color: #f5f5f0;
    background-image:
      radial-gradient(circle 1.5px at 1.5px 1.5px, rgba(0, 0, 0, 0.15) 100%, transparent 100%),
      radial-gradient(circle 0.8px at 0.8px 0.8px, rgba(0, 0, 0, 0.07) 100%, transparent 100%);
    background-size: 200px 200px, 40px 40px;
  }
</style>


{/* ─── Variation 5: Particle canvas script ─── */}
<script>
  const canvas = document.getElementById('hero-canvas-v5') as HTMLCanvasElement;
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const PARTICLE_COUNT = 120;
    const CONNECTION_DISTANCE = 180;
    const MOUSE_RADIUS = 250;
    const BASE_SPEED = 0.4;

    const VIOLET_BRAND = { r: 124, g: 58, b: 237 };
    const VIOLET_LIGHT = { r: 167, g: 139, b: 250 };

    let width = 0;
    let height = 0;
    let mouseX = -1000;
    let mouseY = -1000;
    let animationId: number;

    interface Particle {
      x: number;
      y: number;
      vx: number;
      vy: number;
      radius: number;
      brightness: number;
    }

    const particles: Particle[] = [];

    function resize() {
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      canvas.width = width * dpr;
      canvas.height = height * dpr;
      ctx.scale(dpr, dpr);
    }

    function createParticles() {
      particles.length = 0;
      for (let i = 0; i < PARTICLE_COUNT; i++) {
        particles.push({
          x: Math.random() * width,
          y: Math.random() * height,
          vx: (Math.random() - 0.5) * BASE_SPEED * 2,
          vy: (Math.random() - 0.5) * BASE_SPEED * 2,
          radius: Math.random() * 2.5 + 1,
          brightness: Math.random(),
        });
      }
    }

    function draw() {
      // Clear with transparency so the CSS grid shows through
      ctx.clearRect(0, 0, width, height);

      // Subtle radial glow on canvas (additive with the CSS grid)
      const glowOpacity = 0.03;
      const centreGlow = ctx.createRadialGradient(
        width * 0.5, height * 0.45, 0,
        width * 0.5, height * 0.45, Math.max(width, height) * 0.6
      );
      centreGlow.addColorStop(0, `rgba(124, 58, 237, ${glowOpacity})`);
      centreGlow.addColorStop(0.4, `rgba(124, 58, 237, ${glowOpacity * 0.4})`);
      centreGlow.addColorStop(1, 'transparent');
      ctx.fillStyle = centreGlow;
      ctx.fillRect(0, 0, width, height);

      // Connections
      for (let i = 0; i < particles.length; i++) {
        for (let j = i + 1; j < particles.length; j++) {
          const dx = particles[i].x - particles[j].x;
          const dy = particles[i].y - particles[j].y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < CONNECTION_DISTANCE) {
            const opacity = (1 - dist / CONNECTION_DISTANCE) * 0.35;
            ctx.strokeStyle = `rgba(${VIOLET_BRAND.r}, ${VIOLET_BRAND.g}, ${VIOLET_BRAND.b}, ${opacity})`;
            ctx.lineWidth = 0.8;
            ctx.beginPath();
            ctx.moveTo(particles[i].x, particles[i].y);
            ctx.lineTo(particles[j].x, particles[j].y);
            ctx.stroke();
          }
        }
      }

      // Mouse connections
      if (mouseX > 0 && mouseY > 0) {
        for (const p of particles) {
          const dx = mouseX - p.x;
          const dy = mouseY - p.y;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < MOUSE_RADIUS) {
            const opacity = (1 - dist / MOUSE_RADIUS) * 0.45;
            ctx.strokeStyle = `rgba(${VIOLET_LIGHT.r}, ${VIOLET_LIGHT.g}, ${VIOLET_LIGHT.b}, ${opacity})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(mouseX, mouseY);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
          }
        }
      }

      // Particles
      for (const p of particles) {
        const r = Math.round(VIOLET_BRAND.r + (VIOLET_LIGHT.r - VIOLET_BRAND.r) * p.brightness);
        const g = Math.round(VIOLET_BRAND.g + (VIOLET_LIGHT.g - VIOLET_BRAND.g) * p.brightness);
        const b = Math.round(VIOLET_BRAND.b + (VIOLET_LIGHT.b - VIOLET_BRAND.b) * p.brightness);

        const glowRadius = p.radius * 2.5;
        const glow = ctx.createRadialGradient(p.x, p.y, 0, p.x, p.y, glowRadius);
        glow.addColorStop(0, `rgba(${r}, ${g}, ${b}, 0.1)`);
        glow.addColorStop(0.3, `rgba(${r}, ${g}, ${b}, 0.03)`);
        glow.addColorStop(1, 'transparent');
        ctx.fillStyle = glow;
        ctx.fillRect(p.x - glowRadius, p.y - glowRadius, glowRadius * 2, glowRadius * 2);

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(${r}, ${g}, ${b}, 0.35)`;
        ctx.fill();
      }
    }

    function update() {
      for (const p of particles) {
        if (mouseX > 0 && mouseY > 0) {
          const dx = p.x - mouseX;
          const dy = p.y - mouseY;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist < MOUSE_RADIUS && dist > 0) {
            const force = (1 - dist / MOUSE_RADIUS) * 0.5;
            p.vx += (dx / dist) * force;
            p.vy += (dy / dist) * force;
          }
        }

        p.vx *= 0.99;
        p.vy *= 0.99;

        const speed = Math.sqrt(p.vx * p.vx + p.vy * p.vy);
        if (speed > BASE_SPEED * 3) {
          p.vx = (p.vx / speed) * BASE_SPEED * 3;
          p.vy = (p.vy / speed) * BASE_SPEED * 3;
        }

        if (speed < BASE_SPEED * 0.5) {
          p.vx += (Math.random() - 0.5) * 0.1;
          p.vy += (Math.random() - 0.5) * 0.1;
        }

        p.x += p.vx;
        p.y += p.vy;

        const pad = 50;
        if (p.x < -pad) p.x = width + pad;
        if (p.x > width + pad) p.x = -pad;
        if (p.y < -pad) p.y = height + pad;
        if (p.y > height + pad) p.y = -pad;
      }
    }

    function animate() {
      update();
      draw();
      animationId = requestAnimationFrame(animate);
    }

    function drawStatic() {
      draw();
    }

    window.addEventListener('resize', () => {
      resize();
      if (prefersReducedMotion) drawStatic();
    });

    let isDragging = false;
    let dragMoved = false;
    let dragThrottle = 0;
    const DRAG_SPAWN_INTERVAL = 40;

    const heroSection = canvas.closest('section')!;

    heroSection.addEventListener('mousemove', (e: Event) => {
      const me = e as MouseEvent;
      const rect = canvas.getBoundingClientRect();
      mouseX = me.clientX - rect.left;
      mouseY = me.clientY - rect.top;

      if (isDragging) {
        dragMoved = true;
        const now = performance.now();
        if (now - dragThrottle > DRAG_SPAWN_INTERVAL) {
          dragThrottle = now;
          const angle = Math.random() * Math.PI * 2;
          const speed = BASE_SPEED * (0.3 + Math.random() * 0.5);
          particles.push({
            x: mouseX + (Math.random() - 0.5) * 8,
            y: mouseY + (Math.random() - 0.5) * 8,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            radius: Math.random() * 2 + 1.5,
            brightness: 0.8 + Math.random() * 0.2,
          });
        }
      }
    });

    heroSection.addEventListener('mouseleave', () => {
      mouseX = -1000;
      mouseY = -1000;
      isDragging = false;
    });

    heroSection.addEventListener('mousedown', () => {
      isDragging = true;
      dragMoved = false;
      dragThrottle = 0;
    });

    window.addEventListener('mouseup', () => {
      isDragging = false;
    });

    heroSection.addEventListener('click', (e: Event) => {
      if (dragMoved) return;

      const me = e as MouseEvent;
      const rect = canvas.getBoundingClientRect();
      const cx = me.clientX - rect.left;
      const cy = me.clientY - rect.top;

      const BURST_COUNT = 5;
      for (let i = 0; i < BURST_COUNT; i++) {
        const angle = (Math.PI * 2 * i) / BURST_COUNT;
        const speed = BASE_SPEED * (1.5 + Math.random());
        particles.push({
          x: cx,
          y: cy,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          radius: Math.random() * 2.5 + 1,
          brightness: 0.7 + Math.random() * 0.3,
        });
      }
    });

    resize();
    createParticles();

    if (prefersReducedMotion) {
      drawStatic();
    } else {
      animate();
    }

    window.addEventListener('themechange', () => {
      if (prefersReducedMotion) drawStatic();
    });

    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationId);
    });
  }
</script>

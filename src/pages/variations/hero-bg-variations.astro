---
// HERO BACKGROUND VARIATIONS — 5 different background treatments for the hero section
// Each variation uses the same hero+about layout from hero-test-3a but with a different background
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import avatar from '../../assets/headshot/avatar.png';
---

<BaseLayout title="Hero Background Variations — viv.me.uk">
  <main id="main-content">

    {/* ─── Navigation between variations ─── */}
    <nav class="fixed top-0 left-0 right-0 z-50 bg-bg/80 backdrop-blur-sm border-b border-border-subtle">
      <div class="max-w-5xl mx-auto px-6 py-3 flex items-center gap-6 overflow-x-auto text-sm">
        <span class="font-semibold text-text-primary whitespace-nowrap">BG Variations</span>
        <a href="#v1" class="text-text-secondary hover:text-accent transition-colors whitespace-nowrap">1. Graph Paper</a>
        <a href="#v2" class="text-text-secondary hover:text-accent transition-colors whitespace-nowrap">2. Blueprint</a>
        <a href="#v3" class="text-text-secondary hover:text-accent transition-colors whitespace-nowrap">3. Animated Glow</a>
        <a href="#v4" class="text-text-secondary hover:text-accent transition-colors whitespace-nowrap">4. Dot Matrix</a>
        <a href="#v5" class="text-text-secondary hover:text-accent transition-colors whitespace-nowrap">5. Grid + Particles</a>
        <a href="/variations/hero-test-3a" class="text-accent hover:text-accent-light transition-colors whitespace-nowrap ml-auto">← Current Hero</a>
      </div>
    </nav>


    {/* ═══════════════════════════════════════════════════════════════════
        VARIATION 1: Graph Paper Grid
        CSS-only grid. Fine + major grid lines,
        subtle violet radial glow behind centre.
       ═══════════════════════════════════════════════════════════════════ */}
    <section id="v1" class="variation-section relative isolate min-h-screen flex items-center pt-20 pb-32 overflow-hidden">
      {/* Grid background */}
      <div aria-hidden="true" class="absolute inset-0 z-0 bg-grid-paper"></div>
      {/* Radial glow */}
      <div aria-hidden="true" class="absolute inset-0 z-0 bg-glow-violet"></div>
      {/* Bottom fade */}
      <div aria-hidden="true" class="hero-bottom-fade absolute inset-0 z-[1] pointer-events-none"></div>

      {/* Label */}
      <div class="absolute top-20 left-6 z-20">
        <span class="inline-block px-3 py-1 text-xs font-mono bg-bg-surface/80 border border-border-subtle rounded-full text-text-secondary">
          Variation 1 — Graph Paper Grid
        </span>
        <p class="mt-2 text-xs text-text-tertiary max-w-xs">CSS-only fine + major grid lines with violet radial glow. No animation.</p>
      </div>

      <div class="max-w-5xl mx-auto px-6 w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-12 lg:gap-20 items-center">
          <div class="text-center lg:text-left">
            <Image
              src={avatar}
              alt="Viv — portrait photo"
              width={160}
              height={160}
              class="w-28 h-28 sm:w-40 sm:h-40 rounded-full border-2 border-border-subtle mx-auto lg:mx-0 mb-8"
            />
            <h1 class="hero-title text-6xl sm:text-7xl md:text-8xl font-bold tracking-tight">
              Viv.
            </h1>
            <p class="mt-3 text-lg text-text-secondary">
              Software engineer.<br />Building things that matter.
            </p>
          </div>
          <div class="space-y-6">
            <p class="text-lg text-text-primary leading-relaxed">
              I've been writing software since the late 90s. In that time I've learned that tools change constantly but the principles of good engineering don't.
            </p>
            <p class="text-lg text-text-primary leading-relaxed">
              I'm a Chartered Engineer and a member of the BCS, and I studied Computer Science at Cardiff University. I live in South Wales and I've worked remotely for most of my career, long before it was fashionable. Most of my career has been spent building systems where the stakes are high — national cyber security infrastructure, government services, child safeguarding platforms, identity verification at scale.
            </p>
            <p class="text-lg text-text-primary leading-relaxed">
              These days I'm deeply focused on how AI is reshaping the craft of software engineering. Not replacing what experienced engineers do, but amplifying it in ways I find genuinely exciting. After more than 25 years, this is the most significant shift I've seen.
            </p>
          </div>
        </div>
      </div>

      <div aria-hidden="true" class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 z-10">
        <span class="text-xs text-text-tertiary tracking-widest uppercase">Scroll</span>
        <svg class="w-5 h-5 text-text-tertiary animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </section>


    {/* ═══════════════════════════════════════════════════════════════════
        VARIATION 2: Blueprint / Architectural Drawing
        Denser grid with blue tint, decorative corner markers,
        subtle cyan/blue glow.
       ═══════════════════════════════════════════════════════════════════ */}
    <section id="v2" class="variation-section relative isolate min-h-screen flex items-center pt-20 pb-32 overflow-hidden">
      {/* Blueprint grid background */}
      <div aria-hidden="true" class="absolute inset-0 z-0 bg-blueprint"></div>
      {/* Corner markers */}
      <div aria-hidden="true" class="blueprint-corner blueprint-corner--tl"></div>
      <div aria-hidden="true" class="blueprint-corner blueprint-corner--tr"></div>
      <div aria-hidden="true" class="blueprint-corner blueprint-corner--bl"></div>
      <div aria-hidden="true" class="blueprint-corner blueprint-corner--br"></div>
      {/* Radial glow — cyan/blue tint */}
      <div aria-hidden="true" class="absolute inset-0 z-0 bg-glow-blueprint"></div>
      {/* Bottom fade */}
      <div aria-hidden="true" class="hero-bottom-fade absolute inset-0 z-[1] pointer-events-none"></div>

      {/* Label */}
      <div class="absolute top-20 left-6 z-20">
        <span class="inline-block px-3 py-1 text-xs font-mono bg-bg-surface/80 border border-border-subtle rounded-full text-text-secondary">
          Variation 2 — Blueprint
        </span>
        <p class="mt-2 text-xs text-text-tertiary max-w-xs">Dense blue-tinted grid with corner markers and cyan glow. Architectural drawing feel.</p>
      </div>

      <div class="max-w-5xl mx-auto px-6 w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-12 lg:gap-20 items-center">
          <div class="text-center lg:text-left">
            <Image
              src={avatar}
              alt="Viv — portrait photo"
              width={160}
              height={160}
              class="w-28 h-28 sm:w-40 sm:h-40 rounded-full border-2 border-border-subtle mx-auto lg:mx-0 mb-8"
            />
            <h1 class="hero-title text-6xl sm:text-7xl md:text-8xl font-bold tracking-tight">
              Viv.
            </h1>
            <p class="mt-3 text-lg text-text-secondary">
              Software engineer.<br />Building things that matter.
            </p>
          </div>
          <div class="space-y-6">
            <p class="text-lg text-text-primary leading-relaxed">
              I've been writing software since the late 90s. In that time I've learned that tools change constantly but the principles of good engineering don't.
            </p>
            <p class="text-lg text-text-primary leading-relaxed">
              I'm a Chartered Engineer and a member of the BCS, and I studied Computer Science at Cardiff University. I live in South Wales and I've worked remotely for most of my career, long before it was fashionable. Most of my career has been spent building systems where the stakes are high — national cyber security infrastructure, government services, child safeguarding platforms, identity verification at scale.
            </p>
            <p class="text-lg text-text-primary leading-relaxed">
              These days I'm deeply focused on how AI is reshaping the craft of software engineering. Not replacing what experienced engineers do, but amplifying it in ways I find genuinely exciting. After more than 25 years, this is the most significant shift I've seen.
            </p>
          </div>
        </div>
      </div>

      <div aria-hidden="true" class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 z-10">
        <span class="text-xs text-text-tertiary tracking-widest uppercase">Scroll</span>
        <svg class="w-5 h-5 text-text-tertiary animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </section>


    {/* ═══════════════════════════════════════════════════════════════════
        VARIATION 3: Animated Grid with Glow
        Static graph paper grid + breathing/pulsing radial glow.
        Respects prefers-reduced-motion.
       ═══════════════════════════════════════════════════════════════════ */}
    <section id="v3" class="variation-section relative isolate min-h-screen flex items-center pt-20 pb-32 overflow-hidden">
      {/* Static grid */}
      <div aria-hidden="true" class="absolute inset-0 z-0 bg-grid-paper"></div>
      {/* Animated breathing glow */}
      <div aria-hidden="true" class="absolute inset-0 z-0 bg-glow-breathing"></div>
      {/* Bottom fade */}
      <div aria-hidden="true" class="hero-bottom-fade absolute inset-0 z-[1] pointer-events-none"></div>

      {/* Label */}
      <div class="absolute top-20 left-6 z-20">
        <span class="inline-block px-3 py-1 text-xs font-mono bg-bg-surface/80 border border-border-subtle rounded-full text-text-secondary">
          Variation 3 — Animated Glow
        </span>
        <p class="mt-2 text-xs text-text-tertiary max-w-xs">Graph paper grid with a slowly breathing radial glow. Respects reduced-motion preference.</p>
      </div>

      <div class="max-w-5xl mx-auto px-6 w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-12 lg:gap-20 items-center">
          <div class="text-center lg:text-left">
            <Image
              src={avatar}
              alt="Viv — portrait photo"
              width={160}
              height={160}
              class="w-28 h-28 sm:w-40 sm:h-40 rounded-full border-2 border-border-subtle mx-auto lg:mx-0 mb-8"
            />
            <h1 class="hero-title text-6xl sm:text-7xl md:text-8xl font-bold tracking-tight">
              Viv.
            </h1>
            <p class="mt-3 text-lg text-text-secondary">
              Software engineer.<br />Building things that matter.
            </p>
          </div>
          <div class="space-y-6">
            <p class="text-lg text-text-primary leading-relaxed">
              I've been writing software since the late 90s. In that time I've learned that tools change constantly but the principles of good engineering don't.
            </p>
            <p class="text-lg text-text-primary leading-relaxed">
              I'm a Chartered Engineer and a member of the BCS, and I studied Computer Science at Cardiff University. I live in South Wales and I've worked remotely for most of my career, long before it was fashionable. Most of my career has been spent building systems where the stakes are high — national cyber security infrastructure, government services, child safeguarding platforms, identity verification at scale.
            </p>
            <p class="text-lg text-text-primary leading-relaxed">
              These days I'm deeply focused on how AI is reshaping the craft of software engineering. Not replacing what experienced engineers do, but amplifying it in ways I find genuinely exciting. After more than 25 years, this is the most significant shift I've seen.
            </p>
          </div>
        </div>
      </div>

      <div aria-hidden="true" class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 z-10">
        <span class="text-xs text-text-tertiary tracking-widest uppercase">Scroll</span>
        <svg class="w-5 h-5 text-text-tertiary animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </section>


    {/* ═══════════════════════════════════════════════════════════════════
        VARIATION 4: Dot Matrix
        Repeating dot pattern at grid intersections instead of lines.
        Engineering paper aesthetic with radial glow.
       ═══════════════════════════════════════════════════════════════════ */}
    <section id="v4" class="variation-section relative isolate min-h-screen flex items-center pt-20 pb-32 overflow-hidden">
      {/* Dot matrix background */}
      <div aria-hidden="true" class="absolute inset-0 z-0 bg-dot-matrix"></div>
      {/* Radial glow */}
      <div aria-hidden="true" class="absolute inset-0 z-0 bg-glow-violet"></div>
      {/* Bottom fade */}
      <div aria-hidden="true" class="hero-bottom-fade absolute inset-0 z-[1] pointer-events-none"></div>

      {/* Label */}
      <div class="absolute top-20 left-6 z-20">
        <span class="inline-block px-3 py-1 text-xs font-mono bg-bg-surface/80 border border-border-subtle rounded-full text-text-secondary">
          Variation 4 — Dot Matrix
        </span>
        <p class="mt-2 text-xs text-text-tertiary max-w-xs">Repeating tiny dots at grid intersections. Engineering paper feel with violet radial glow.</p>
      </div>

      <div class="max-w-5xl mx-auto px-6 w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-12 lg:gap-20 items-center">
          <div class="text-center lg:text-left">
            <Image
              src={avatar}
              alt="Viv — portrait photo"
              width={160}
              height={160}
              class="w-28 h-28 sm:w-40 sm:h-40 rounded-full border-2 border-border-subtle mx-auto lg:mx-0 mb-8"
            />
            <h1 class="hero-title text-6xl sm:text-7xl md:text-8xl font-bold tracking-tight">
              Viv.
            </h1>
            <p class="mt-3 text-lg text-text-secondary">
              Software engineer.<br />Building things that matter.
            </p>
          </div>
          <div class="space-y-6">
            <p class="text-lg text-text-primary leading-relaxed">
              I've been writing software since the late 90s. In that time I've learned that tools change constantly but the principles of good engineering don't.
            </p>
            <p class="text-lg text-text-primary leading-relaxed">
              I'm a Chartered Engineer and a member of the BCS, and I studied Computer Science at Cardiff University. I live in South Wales and I've worked remotely for most of my career, long before it was fashionable. Most of my career has been spent building systems where the stakes are high — national cyber security infrastructure, government services, child safeguarding platforms, identity verification at scale.
            </p>
            <p class="text-lg text-text-primary leading-relaxed">
              These days I'm deeply focused on how AI is reshaping the craft of software engineering. Not replacing what experienced engineers do, but amplifying it in ways I find genuinely exciting. After more than 25 years, this is the most significant shift I've seen.
            </p>
          </div>
        </div>
      </div>

      <div aria-hidden="true" class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 z-10">
        <span class="text-xs text-text-tertiary tracking-widest uppercase">Scroll</span>
        <svg class="w-5 h-5 text-text-tertiary animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </section>


    {/* ═══════════════════════════════════════════════════════════════════
        VARIATION 5: Graph Paper + Particle Network
        Combines the CSS grid from variation 1 WITH the interactive
        particle canvas on top. Particles draw over the grid for depth.
       ═══════════════════════════════════════════════════════════════════ */}
    <section id="v5" class="variation-section relative isolate min-h-screen flex items-center pt-20 pb-32 overflow-hidden">
      {/* Grid background underneath the canvas */}
      <div aria-hidden="true" class="absolute inset-0 z-0 bg-grid-paper"></div>
      {/* Particle canvas — draws on top of the grid */}
      <canvas
        id="hero-canvas-v5"
        aria-hidden="true"
        class="absolute inset-0 z-[1] w-full h-full"
      />
      {/* Bottom fade */}
      <div aria-hidden="true" class="hero-bottom-fade absolute inset-0 z-[2] pointer-events-none"></div>

      {/* Label */}
      <div class="absolute top-20 left-6 z-20">
        <span class="inline-block px-3 py-1 text-xs font-mono bg-bg-surface/80 border border-border-subtle rounded-full text-text-secondary">
          Variation 5 — Grid + Particles
        </span>
        <p class="mt-2 text-xs text-text-tertiary max-w-xs">CSS graph paper grid with interactive particle network layered on top. Combines both approaches.</p>
      </div>

      <div class="max-w-5xl mx-auto px-6 w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-[auto_1fr] gap-12 lg:gap-20 items-center">
          <div class="text-center lg:text-left">
            <Image
              src={avatar}
              alt="Viv — portrait photo"
              width={160}

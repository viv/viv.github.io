---
import BaseLayout from '../../layouts/BaseLayout.astro';

const variations = [
  {
    id: 'warm-copper',
    label: '1. Warm Copper',
    description: 'Copper accent, warm cream text, charcoal background.',
    bg: '#0f1014',
    surface: '#16171c',
    border: 'rgba(255,255,255,.06)',
    accent: '#c47a3a',
    accentHover: '#d99050',
    accentGlow: 'rgba(196,122,58,.08)',
    heading: '#c47a3a',
    text: 'rgba(255,228,200,.92)',
    subtext: 'rgba(220,180,145,.6)',
    gridFine: 'rgba(255,255,255,.025)',
    gridMajor: 'rgba(255,255,255,.045)',
  },
  {
    id: 'cool-violet',
    label: '2. Cool Slate + Violet',
    description: 'Current violet accents with warmer charcoal background and chalk body text.',
    bg: '#0f1014',
    surface: '#16171c',
    border: 'rgba(255,255,255,.06)',
    accent: '#A78BFA',
    accentHover: '#C4B5FD',
    accentGlow: 'rgba(139,92,246,.08)',
    heading: '#A78BFA',
    text: 'rgba(235,230,220,.65)',
    subtext: 'rgba(200,195,185,.4)',
    gridFine: 'rgba(255,255,255,.025)',
    gridMajor: 'rgba(255,255,255,.045)',
  },
  {
    id: 'copper-violet',
    label: '3. Warm Copper + Violet Hybrid',
    description: 'Copper for primary accents, violet for secondary/hover states. Best of both worlds.',
    bg: '#0f1014',
    surface: '#16171c',
    border: 'rgba(255,255,255,.06)',
    accent: '#c47a3a',
    accentHover: '#7C3AED',
    accentGlow: 'rgba(196,122,58,.06)',
    heading: '#c47a3a',
    text: 'rgba(255,228,200,.92)',
    subtext: 'rgba(220,180,145,.6)',
    gridFine: 'rgba(255,255,255,.025)',
    gridMajor: 'rgba(255,255,255,.045)',
  },
  {
    id: 'charcoal-emerald',
    label: '4. Charcoal + Emerald',
    description: 'A distinctly different feel — emerald green accent with warm off-white text.',
    bg: '#0f1014',
    surface: '#16171c',
    border: 'rgba(255,255,255,.06)',
    accent: '#10B981',
    accentHover: '#34D399',
    accentGlow: 'rgba(16,185,129,.08)',
    heading: '#10B981',
    text: 'rgba(245,240,230,.85)',
    subtext: 'rgba(200,195,185,.5)',
    gridFine: 'rgba(255,255,255,.025)',
    gridMajor: 'rgba(255,255,255,.045)',
  },
];
---

<BaseLayout title="Colour Scheme Variations — Viv">
  <main id="main-content" class="py-16 px-6">
    <div class="max-w-5xl mx-auto mb-16">
      <h1 class="text-4xl sm:text-5xl font-bold text-text-primary mb-4">Colour Scheme Variations</h1>
      <p class="text-text-secondary text-lg max-w-2xl">
        Four colour palettes on a graph-paper grid background. Each shows the same representative UI elements
        for direct comparison.
      </p>
      <nav class="mt-8 flex flex-wrap gap-3">
        {variations.map((v) => (
          <a
            href={`#${v.id}`}
            class="text-sm px-3 py-1.5 rounded border border-border-subtle text-text-secondary hover:text-accent hover:border-accent transition-colors"
          >
            {v.label}
          </a>
        ))}
      </nav>
    </div>

    {variations.map((v) => (
      <section
        id={v.id}
        class="variation-section mb-20 rounded-xl overflow-hidden"
        style={`
          --v-bg: ${v.bg};
          --v-surface: ${v.surface};
          --v-border: ${v.border};
          --v-accent: ${v.accent};
          --v-accent-hover: ${v.accentHover};
          --v-glow: ${v.accentGlow};
          --v-heading: ${v.heading};
          --v-text: ${v.text};
          --v-subtext: ${v.subtext};
          --v-grid-fine: ${v.gridFine};
          --v-grid-major: ${v.gridMajor};
          background-color: var(--v-bg);
          color: var(--v-text);
        `}
      >
        {/* Graph paper grid background + radial glow */}
        <div class="variation-grid relative" style="position: relative;">
          {/* Radial accent glow */}
          <div
            class="absolute inset-0 pointer-events-none"
            style={`background: radial-gradient(ellipse 60% 40% at 50% 30%, ${v.accentGlow.replace('.08', '.12').replace('.06', '.10')}, transparent 70%);`}
          />

          <div class="relative z-10 max-w-4xl mx-auto px-8 py-16 sm:px-12 sm:py-20">
            {/* Section label */}
            <div class="mb-12">
              <span
                class="inline-block text-xs font-mono uppercase tracking-widest px-2 py-1 rounded"
                style={`color: var(--v-accent); border: 1px solid var(--v-border);`}
              >
                {v.label}
              </span>
              <p class="mt-3 text-sm" style="color: var(--v-subtext);">
                {v.description}
              </p>
            </div>

            {/* Hero heading */}
            <h2
              class="text-6xl sm:text-7xl font-bold tracking-tight"
              style="color: var(--v-heading);"
            >
              Viv.
            </h2>
            <p
              class="mt-3 text-xl sm:text-2xl font-light"
              style="color: var(--v-subtext);"
            >
              Software engineer. Building things that matter.
            </p>

            {/* Body text */}
            <div class="mt-10 max-w-2xl">
              <p class="leading-relaxed" style="color: var(--v-text);">
                Twenty-five years of building software that works — from early web development through
                cybersecurity platforms to AI-enhanced engineering. Based in South Wales, working globally.
                This is a career built on craft, not trends.
              </p>
              <p class="mt-4">
                <a
                  href="#"
                  class="transition-colors"
                  style={`color: var(--v-accent); text-decoration: underline; text-underline-offset: 3px;`}
                  onmouseover="this.style.color=this.closest('.variation-section').style.getPropertyValue('--v-accent-hover')"
                  onmouseout="this.style.color=this.closest('.variation-section').style.getPropertyValue('--v-accent')"
                >
                  View the full timeline &rarr;
                </a>
              </p>
            </div>

            {/* Sample card — Beyond the Code style */}
            <div class="mt-12">
              <h3 class="text-sm font-mono uppercase tracking-wider mb-4" style="color: var(--v-subtext);">
                Sample Card
              </h3>
              <div
                class="rounded-lg p-6 sm:p-8 transition-all duration-200"
                style={`background-color: var(--v-surface); border: 1px solid var(--v-border);`}
              >
                <h4 class="text-lg font-semibold" style="color: var(--v-heading);">
                  Wado Ryu Karate
                </h4>
                <p class="mt-2 text-sm leading-relaxed" style="color: var(--v-subtext);">
                  3rd Dan. I teach. This isn't a hobby — it's a parallel discipline of teaching,
                  leadership, and personal development pursued for decades.
                </p>
                <a
                  href="#"
                  class="inline-block mt-3 text-sm transition-colors"
                  style={`color: var(--v-accent);`}
                >
                  ogwrkarate.co.uk &#x2197;
                </a>
              </div>
            </div>

            {/* Sample timeline entry */}
            <div class="mt-12">
              <h3 class="text-sm font-mono uppercase tracking-wider mb-4" style="color: var(--v-subtext);">
                Sample Timeline Entry
              </h3>
              <div class="relative pl-10">
                {/* Timeline line */}
                <div
                  class="absolute left-[6px] top-0 bottom-0 w-px"
                  style="background-color: var(--v-border);"
                />
                {/* Timeline dot */}
                <div
                  class="absolute left-0 top-6 w-3 h-3 rounded-full"
                  style={`background-color: var(--v-accent); border: 2px solid var(--v-bg);`}
                />

                <div
                  class="rounded-lg p-6 sm:p-8"
                  style={`background-color: var(--v-surface); border: 1px solid var(--v-border);`}
                >
                  <span class="text-sm" style="color: var(--v-subtext);">2020</span>
                  <h4 class="mt-1 text-lg font-semibold" style="color: var(--v-text);">
                    AI-Enhanced Engineering
                  </h4>
                  <p class="mt-1 text-lg italic" style="color: var(--v-accent);">
                    &ldquo;The craft evolves, the craftsman adapts.&rdquo;
                  </p>
                  <p class="mt-3 leading-relaxed" style="color: var(--v-text);">
                    Integrating AI into development workflows — not replacing judgement, but augmenting it.
                    Using large language models as a force multiplier for code quality, architectural
                    thinking, and documentation.
                  </p>
                  <p class="mt-3 text-sm font-mono italic" style="color: var(--v-subtext);">
                    Python, LangChain, OpenAI API, Claude, prompt engineering
                  </p>
                </div>
              </div>
            </div>

            {/* Colour swatch row */}
            <div class="mt-12">
              <h3 class="text-sm font-mono uppercase tracking-wider mb-4" style="color: var(--v-subtext);">
                Palette
              </h3>
              <div class="flex flex-wrap gap-3">
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded" style={`background-color: var(--v-bg); border: 1px solid var(--v-border);`} />
                  <span class="text-xs font-mono" style="color: var(--v-subtext);">bg</span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded" style={`background-color: var(--v-surface); border: 1px solid var(--v-border);`} />
                  <span class="text-xs font-mono" style="color: var(--v-subtext);">surface</span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded" style={`background-color: var(--v-accent);`} />
                  <span class="text-xs font-mono" style="color: var(--v-subtext);">accent</span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-6 h-6 rounded" style={`background-color: var(--v-accent-hover);`} />
                  <span class="text-xs font-mono" style="color: var(--v-subtext);">hover</span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-8 h-6 rounded" style={`background-color: var(--v-text); border: 1px solid var(--v-border);`} />
                  <span class="text-xs font-mono" style="color: var(--v-subtext);">text</span>
                </div>
                <div class="flex items-center gap-2">
                  <div class="w-8 h-6 rounded" style={`background-color: var(--v-subtext);`} />
                  <span class="text-xs font-mono" style="color: var(--v-subtext);">sub</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  /* Graph paper grid background for each variation section */
  .variation-grid {
    background-image:
      linear-gradient(var(--v-grid-fine) 1px, transparent 1px),
      linear-gradient(90deg, var(--v-grid-fine) 1px, transparent 1px),
      linear-gradient(var(--v-grid-major) 1px, transparent 1px),
      linear-gradient(90deg, var(--v-grid-major) 1px, transparent 1px);
    background-size:
      20px 20px,
      20px 20px,
      100px 100px,
      100px 100px;
  }
</style>

---
interface Props {
  title: string;
  description?: string;
  /** ISO date string for BlogPosting schema */
  datePublished?: string;
  /** Tags/keywords for the page */
  tags?: string[];
}

const {
  title,
  description = 'Matthew Vivian is a Chartered Software Engineer with 25+ years of experience in systems design, security, and AI-native engineering. Based in South Wales.',
  datePublished,
  tags,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const isNote = Astro.url.pathname.startsWith('/notes/') && !Astro.url.pathname.startsWith('/notes/tags/') && Astro.url.pathname !== '/notes/' && Astro.url.pathname !== '/notes';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Matthew Vivian" />
    <link rel="canonical" href={canonicalURL.href} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content="https://www.viv.me.uk/social-sharing-preview.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Matthew Vivian — Software Engineer" />
    <meta property="og:site_name" content="Viv — Software Engineer" />
    <meta property="og:locale" content="en_GB" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.viv.me.uk/social-sharing-preview.png" />

    <!-- Fonts — critical (Space Grotesk) loaded eagerly, mono deferred -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    </noscript>

    <title>{title}</title>

    {/* JSON-LD Structured Data */}
    {isHome && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          {
            "@type": "WebSite",
            "name": "Viv — Software Engineer",
            "url": "https://www.viv.me.uk",
          },
          {
            "@type": "Person",
            "name": "Matthew Vivian",
            "url": "https://www.viv.me.uk",
            "image": "https://www.viv.me.uk/social-sharing-preview.png",
            "jobTitle": "Chartered Software Engineer",
            "description": "Software engineer with 25+ years of experience in systems design, security, and AI-native engineering",
            "sameAs": [
              "https://www.linkedin.com/in/bmvivian",
              "https://github.com/viv"
            ],
            "knowsAbout": ["Software Engineering", "Cyber Security", "AI-native Engineering", "Systems Architecture", "XMPP"],
          }
        ]
      })} />
    )}
    {isNote && datePublished && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        "headline": title.replace(' — Viv', ''),
        "description": description,
        "datePublished": datePublished,
        "author": {
          "@type": "Person",
          "name": "Matthew Vivian",
          "url": "https://www.viv.me.uk",
        },
        "url": canonicalURL.href,
        ...(tags && tags.length > 0 ? { keywords: tags.join(', ') } : {}),
      })} />
    )}

    {/* Blocking theme script — prevents flash of wrong theme */}
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved || (prefersDark ? 'dark' : 'dark'); // dark is default
        if (saved === 'light' || (!saved && !prefersDark)) {
          document.documentElement.setAttribute('data-theme', 'light');
        }
      })();
    </script>

    <style is:global>
      @import '../styles/global.css';
    </style>
  </head>
  <body class="bg-bg text-text-primary min-h-screen transition-colors duration-300 overflow-x-hidden">
    {/* Skip to content link for keyboard users */}
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:rounded-lg focus:text-sm focus:font-medium"
    >
      Skip to content
    </a>
    <slot />
  </body>
</html>
